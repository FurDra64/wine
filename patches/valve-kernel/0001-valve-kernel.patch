+static void test_pipe_directory_listing(void)
+{
+    HANDLE hdirectory, hdirectory2, hpipe;
+    FILE_DIRECTORY_INFORMATION *info;
+    DWORD length, context, size;
+    OBJECT_ATTRIBUTES attr;
+    LARGE_INTEGER timeout;
+    UNICODE_STRING name;
