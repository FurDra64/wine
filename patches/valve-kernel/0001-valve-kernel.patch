+static BOOL hack_hide_amd_cpu(void)
+{
+    static int cached = -1;
+
+    if (cached == -1)
+    {
+        const char *env_str;
+        unsigned int regs[4];
+
+        cached = 0;
+        if ((env_str = getenv( "WINE_HIDE_AMD_CPU" )) && *env_str == '1')
+        {
+            do_cpuid( 0, 0, regs );
+            /* AuthenticAMD */
+            cached = (regs[1] == 0x68747541 && regs[2] == 0x444D4163 && regs[3] == 0x69746e65);
+            if (cached) ERR( "HACK: hiding AMD CPU.\n" );
+        }
+    }
+    return cached;
+}
