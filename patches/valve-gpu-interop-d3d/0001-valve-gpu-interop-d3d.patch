+            D3DX11_IFF_DDS, FALSE);
+    DeleteFileW(L"test_w.dds");
+
+    ID3D11Texture2D_Release(tex_2d);
+
+    ID3D11DeviceContext_Release(context);
     CoUninitialize();
+
     ok(!ID3D11Device_Release(device), "Unexpected refcount.\n");
 }
 
