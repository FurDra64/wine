+    D3DX11_IMAGE_INFO img_info;
+    ID3D11Resource *resource;
+    ID3D11Texture2D *tex_2d;
+    HMODULE resource_module;
+    ID3D11Device *device;
+    WCHAR path[MAX_PATH];
+    uint32_t i, mip_level;
+    HRESULT hr, hr2;
+
+    device = create_device();
