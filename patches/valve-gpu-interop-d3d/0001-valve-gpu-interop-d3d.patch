+            D3DX11_IFF_DDS, FALSE);
+    DeleteFileA("test_a.dds");
+
+    hr = D3DX11SaveTextureToFileW(context, (ID3D11Resource *)tex_2d, D3DX11_IFF_DDS, L"test_w.dds");
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
