From: GE-Proton <noreply@localhost>
Subject: [PATCH] winewayland: bridge Steam overlay through native EGL

When Proton selects its Wine-Wayland overlay bridge, pass the Wayland display
to lsteamclient's native overlay bridge and pump its private event queue before
native OpenGL presents. Keep Wine's EGL dispatch bound directly to the EGL
driver; Steam's GLX interposer must not receive the game's native EGL calls.

Defer creation of the overlay presenter until the first real game swap, when the
drawable's geometry is known. This lets Steam register a fully sized overlay
surface immediately instead of first seeing a hidden 1x1 placeholder.

Rebased onto the per-driver EGL model: the Wayland EGL platform is initialized
by winewayland.drv (wayland_init_egl_platform) instead of win32u, so the bridge
lives in wayland_drawable_swap. Geometry comes from the client surface's
raw/virtual rects; the old win32u coordinate helpers and
is_client_surface_window no longer exist.


diff --git a/dlls/winewayland.drv/opengl.c b/dlls/winewayland.drv/opengl.c
index fb45cf1..da98bab 100644
--- a/dlls/winewayland.drv/opengl.c
+++ b/dlls/winewayland.drv/opengl.c
@@ -118,12 +118,88 @@ err:
     return FALSE;
 }
 
+typedef void (*steam_overlay_opengl_attach_func)( void *display, int x, int y,
+                                                  unsigned int width, unsigned int height );
+typedef void (*steam_overlay_opengl_dispatch_func)( int, int, unsigned int, unsigned int );
+static void *steam_overlay_opengl_handle;
+static void *steam_overlay_opengl_display;
+static BOOL steam_overlay_opengl_attached;
+static steam_overlay_opengl_attach_func steam_overlay_opengl_attach;
+static steam_overlay_opengl_dispatch_func steam_overlay_opengl_dispatch_func_ptr;
+
+static BOOL steam_overlay_opengl_enabled(void)
+{
+    const char *env;
+
+    if (!(env = getenv( "WINE_WAYLAND_STEAM_OVERLAY_LAYER" )) || !atoi( env )) return FALSE;
+    return !(env = getenv( "DISABLE_WINE_WAYLAND_STEAM_OVERLAY_LAYER" )) || !atoi( env );
+}
+
+static BOOL load_steam_overlay_opengl_bridge(void)
+{
+    if (steam_overlay_opengl_attach && steam_overlay_opengl_dispatch_func_ptr) return TRUE;
+    if (!steam_overlay_opengl_enabled()) return FALSE;
+
+    if (!steam_overlay_opengl_handle &&
+        !(steam_overlay_opengl_handle = dlopen( "liblsteamclient_overlay_bridge.so.1",
+                                                RTLD_NOW | RTLD_LOCAL )))
+    {
+        WARN( "Failed to load lsteamclient overlay bridge: %s.\n", dlerror() );
+        return FALSE;
+    }
+
+    steam_overlay_opengl_attach = (steam_overlay_opengl_attach_func)dlsym(
+        steam_overlay_opengl_handle, "ge_overlay_external_wayland_attach" );
+    steam_overlay_opengl_dispatch_func_ptr = (steam_overlay_opengl_dispatch_func)dlsym(
+        steam_overlay_opengl_handle, "ge_overlay_external_wayland_dispatch" );
+    if (!steam_overlay_opengl_attach || !steam_overlay_opengl_dispatch_func_ptr)
+    {
+        WARN( "lsteamclient overlay bridge entry points are unavailable.\n" );
+        steam_overlay_opengl_attach = NULL;
+        steam_overlay_opengl_dispatch_func_ptr = NULL;
+        return FALSE;
+    }
+
+    TRACE( "Loaded lsteamclient native overlay bridge for OpenGL.\n" );
+    return TRUE;
+}
+
+static void steam_overlay_opengl_dispatch( struct opengl_drawable *drawable )
+{
+    RECT rect;
+    UINT width, height;
+
+    if (!steam_overlay_opengl_dispatch_func_ptr || !drawable->client)
+        return;
+
+    /* Client rects are already in raw physical pixels (monitor_rect) or
+     * virtual pixels (virtual_rect), relative to the toplevel visible rect.
+     * Fullscreen games cover the toplevel, so this matches the old
+     * monitor-relative geometry where it matters. */
+    rect = drawable->client->raw ? drawable->client->monitor_rect
+                                 : drawable->client->virtual_rect;
+    width = max( rect.right - rect.left, 1 );
+    height = max( rect.bottom - rect.top, 1 );
+
+    if (!steam_overlay_opengl_attached)
+    {
+        if (!steam_overlay_opengl_display || !steam_overlay_opengl_attach) return;
+        steam_overlay_opengl_attach( steam_overlay_opengl_display,
+                                     rect.left, rect.top, width, height );
+        steam_overlay_opengl_attached = TRUE;
+    }
+
+    steam_overlay_opengl_dispatch_func_ptr( rect.left, rect.top, width, height );
+}
+
 static void wayland_init_egl_platform(struct egl_platform *platform)
 {
     platform->type = EGL_PLATFORM_WAYLAND_KHR;
     platform->native_display = process_wayland.wl_display;
     platform->force_pbuffer_formats = TRUE;
     egl = platform;
+    if (load_steam_overlay_opengl_bridge())
+        steam_overlay_opengl_display = platform->native_display;
 }
 
 static void wayland_drawable_flush(struct opengl_drawable *base, UINT flags)
@@ -144,6 +220,7 @@ static BOOL wayland_drawable_swap(struct opengl_drawable *base)
 {
     struct wayland_gl_drawable *gl = impl_from_opengl_drawable(base);
 
+    steam_overlay_opengl_dispatch( base );
     client_surface_present(base->client);
     funcs->p_eglSwapBuffers(egl->display, gl->base.surface);
 
