From 469a9fea3d1edf55f5725c6e3147798ebba07776 Mon Sep 17 00:00:00 2001
From: Billy Laws <blaws05@gmail.com>
Date: Fri, 19 Apr 2024 20:25:30 +0000
Subject: [PATCH] HACK: Use x86 mono on aarch64.

---
 dlls/appwiz.cpl/addons.c | 4 ++--
 dlls/mscoree/metahost.c  | 2 +-
 2 files changed, 3 insertions(+), 3 deletions(-)

diff --git a/dlls/appwiz.cpl/addons.c b/dlls/appwiz.cpl/addons.c
index 7832447a61a..cec511be5d7 100644
--- a/dlls/appwiz.cpl/addons.c
+++ b/dlls/appwiz.cpl/addons.c
@@ -47,7 +47,7 @@ WINE_DEFAULT_DEBUG_CHANNEL(appwizcpl);
 #ifdef __i386__
 #define GECKO_ARCH "x86"
 #define GECKO_SHA "26cecc47706b091908f7f814bddb074c61beb8063318e9efc5a7f789857793d6"
-#elif defined(__x86_64__)
+#elif defined(__x86_64__) || defined(__aarch64__)
 #define GECKO_ARCH "x86_64"
 #define GECKO_SHA "e590b7d988a32d6aa4cf1d8aa3aa3d33766fdd4cf4c89c2dcc2095ecb28d066f"
 #else
@@ -58,7 +58,7 @@ WINE_DEFAULT_DEBUG_CHANNEL(appwizcpl);
 #endif

 #define MONO_VERSION "11.3.0"
-#if defined(__i386__) || defined(__x86_64__)
+#if defined(__i386__) || defined(__x86_64__) || defined(__aarch64__)
 #define MONO_ARCH "x86"
 #define MONO_SHA "df2dfc1665c2511882e7cabd56eafd0c0a3d94e5a7e86f969277f6c189d418d3"
 #elif defined(__aarch64__)
diff --git a/dlls/mscoree/metahost.c b/dlls/mscoree/metahost.c
index 246d924a81b..13fa02173c8 100644
--- a/dlls/mscoree/metahost.c
+++ b/dlls/mscoree/metahost.c
@@ -712,7 +712,7 @@ HRESULT ICLRRuntimeInfo_GetRuntimeHost(ICLRRuntimeInfo *iface, RuntimeHost **res

 #ifdef __i386__
 static const WCHAR libmono2_arch_dll[] = L"\\bin\\libmono-2.0-x86.dll";
-#elif defined(__x86_64__)
+#elif defined(__x86_64__) || defined(__aarch64__)
 static const WCHAR libmono2_arch_dll[] = L"\\bin\\libmono-2.0-x86_64.dll";
 #elif defined(__aarch64__)
 static const WCHAR libmono2_arch_dll[] = L"\\bin\\libmono-2.0-arm64.dll";
--
2.56.1
