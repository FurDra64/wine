+            hr = d3dx_pixels_init(sub_rsrc.data, sub_rsrc.row_pitch, sub_rsrc.slice_pitch, NULL,
+                    src_info.fmt->format, 0, 0, level_width, level_height, 0, level_depth, &src_pixels);
+            if (SUCCEEDED(hr))
