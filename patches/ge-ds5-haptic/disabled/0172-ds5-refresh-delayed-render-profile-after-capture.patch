From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: GE-Proton <git@localhost>
Date: Sat, 15 Aug 2026 14:00:00 -0600
Subject: [PATCH] ds5: Refresh delayed render profile after capture

PipeWire can report a Sony Default-to-Direct profile transition before the
new Direct render node is ready.  Wine observes the Default render removal,
then receives only the Direct monitor and capture additions.  Since the
render event has already been consumed, the new Direct node is never added to
MMDevAPI.  The retained Windows endpoint consequently keeps the Default
backend name and format, breaking controller haptics and effect audio until a
later profile transition happens to refresh it.

When a Sony capture replacement contains a monitor whose corresponding render
node is still absent, schedule another render refresh.  Promote that delayed
render addition to the stable MMDevice GUID and discard its stale profile
mapping.  This also lets winepulse retarget active raw effect streams once the
new render node actually exists.
---
diff --git a/dlls/winepulse.drv/pulse.c b/dlls/winepulse.drv/pulse.c
index 5fc1580a..4f8f9aff 100644
--- a/dlls/winepulse.drv/pulse.c
+++ b/dlls/winepulse.drv/pulse.c
@@ -172,6 +172,44 @@ static BOOL device_list_has_dualsense_audio_device(struct list *devices)
     return FALSE;
 }
 
+static BOOL device_list_has_missing_dualsense_render_profile(struct list *capture_devices)
+{
+    static const char monitor_suffix[] = ".monitor";
+    PhysDevice *capture, *render;
+
+    LIST_FOR_EACH_ENTRY(capture, capture_devices, PhysDevice, entry)
+    {
+        size_t capture_length, render_length;
+        BOOL found = FALSE;
+
+        if (capture->bus_type != phys_device_bus_usb || capture->vendor_id != 0x054c ||
+                (capture->product_id != 0x05c4 && capture->product_id != 0x09cc &&
+                 capture->product_id != 0x0ce6 && capture->product_id != 0x0df2))
+            continue;
+
+        capture_length = strlen(capture->pulse_name);
+        if (capture_length <= sizeof(monitor_suffix) - 1 ||
+                strcmp(capture->pulse_name + capture_length -
+                (sizeof(monitor_suffix) - 1), monitor_suffix))
+            continue;
+        render_length = capture_length - (sizeof(monitor_suffix) - 1);
+
+        LIST_FOR_EACH_ENTRY(render, &g_phys_speakers, PhysDevice, entry)
+        {
+            if (strlen(render->pulse_name) == render_length &&
+                    !memcmp(render->pulse_name, capture->pulse_name, render_length))
+            {
+                found = TRUE;
+                break;
+            }
+        }
+        if (!found)
+            return TRUE;
+    }
+
+    return FALSE;
+}
+
 static NTSTATUS pulse_not_implemented(void *args)
 {
     return STATUS_SUCCESS;
@@ -567,6 +605,7 @@ static void silence_buffer(pa_sample_format_t format, BYTE *buffer, UINT32 bytes
 
 static BOOL pulse_stream_valid(struct pulse_stream *stream)
 {
+    BOOL refresh_render_after_capture = FALSE;
     pa_stream_state_t state;
 
     if (stream->dualsense_mono_registered)
@@ -691,6 +730,11 @@ static WCHAR *get_device_name(const char *desc, pa_proplist *proplist)
     WCHAR buf[MAX_DEVICE_NAME_LEN + 1];
 
     /* For monitors of sinks; this does not seem to be localized in PA either */
+        refresh_render_after_capture = params->flow == eCapture &&
+                device_list_has_dualsense_audio_device(list_added) &&
+                device_list_has_dualsense_audio_device(list_removed) &&
+                device_list_has_missing_dualsense_render_profile(list_added);
+
     static const WCHAR monitor_of[] = {'M','o','n','i','t','o','r',' ','o','f',' '};
 
     size_t len = strlen(desc);
@@ -767,6 +811,12 @@ static WCHAR *get_device_name(const char *desc, pa_proplist *proplist)
         }
         params->more_data = list_count(other_list_added) + list_count(other_list_removed)
                 || (g_phys_event_mask & other_event_mask);
+        if (refresh_render_after_capture)
+        {
+            TRACE("Scheduling a render refresh after Sony capture profile replacement.\n");
+            g_phys_event_mask |= PHYS_EVENT_RENDER;
+            params->more_data = TRUE;
+        }
     }
     name[len] = '\0';
 
diff --git a/dlls/mmdevapi/devenum.c b/dlls/mmdevapi/devenum.c
index 8ea12dc4..750fd2e5 100644
--- a/dlls/mmdevapi/devenum.c
+++ b/dlls/mmdevapi/devenum.c
@@ -1596,6 +1596,8 @@ static HRESULT set_format(MMDevice *dev)
 static LONG dualsense_mono_render_add_pending;
 static LONG dualsense_mono_activation_serial;
 static enum dualsense_mono_model dualsense_mono_render_add_model;
+static void promote_delayed_dualsense_profile_in_cache(const GUID *guid,
+        const char *added_name, EDataFlow flow);
 
 static void add_endpoints_from_params(struct get_endpoint_ids_params *params, BOOL hotplug)
 {
@@ -1608,6 +1610,7 @@ static void add_endpoints_from_params(struct get_endpoint_ids_params *params, BO
         const char *dev_name = (char *)params->endpoints + params->endpoints[i].device;
         get_device_guid(params->flow, dev_name, TRUE, &guid);
         device = MMDevice_Create(name, &guid, params->flow, DEVICE_STATE_ACTIVE, params->default_idx == i);
+        promote_delayed_dualsense_profile_in_cache(&guid, dev_name, params->flow);
         if (device && params->flow == eRender && is_dualsense_mono_endpoint(device))
         {
             const GUID *id = &device->devguid;
@@ -1632,6 +1635,42 @@ static void add_endpoints_from_params(struct get_endpoint_ids_params *params, BO
     }
 }
 
+static void promote_delayed_dualsense_profile_in_cache(const GUID *guid,
+        const char *added_name, EDataFlow flow)
+{
+    struct device *cached, *next, *current = NULL;
+
+    if (!use_stable_dualsense_device_ids() || !is_dualsense_backend_name(added_name))
+        return;
+
+    EnterCriticalSection(&devices_cache_cs);
+    LIST_FOR_EACH_ENTRY(cached, &devices_cache, struct device, entry)
+    {
+        if (cached->flow == flow && IsEqualGUID(&cached->guid, guid))
+        {
+            current = cached;
+            break;
+        }
+    }
+    if (!current || !dualsense_device_names_replace_profile(added_name, current->name, flow))
+    {
+        LeaveCriticalSection(&devices_cache_cs);
+        return;
+    }
+
+    TRACE("Promoting delayed Sony profile endpoint %s over stale backend %s for %s.\n",
+            debugstr_a(added_name), debugstr_a(current->name), debugstr_guid(guid));
+    LIST_FOR_EACH_ENTRY_SAFE(cached, next, &devices_cache, struct device, entry)
+    {
+        if (cached->flow != flow || !IsEqualGUID(&cached->guid, guid))
+            continue;
+        list_remove(&cached->entry);
+        free(cached);
+    }
+    add_device_to_cache(guid, added_name, flow);
+    LeaveCriticalSection(&devices_cache_cs);
+}
+
 static BOOL endpoint_batch_replaces_dualsense_profile(
         const struct get_endpoint_ids_params *params, const char *removed_name)
 {
