From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: GE-Proton <git@localhost>
Date: Sun, 16 Aug 2026 19:10:00 -0600
Subject: [PATCH] winepulse: Align Death Stranding speaker with active haptics

When more than one Sony controller is present, Death Stranding can create its
Wwise controller-speaker stream on one four-channel endpoint while its native
haptic stream uses another. Endpoint enumeration order cannot identify the
active controller reliably and changes between runs, leaving AUX1 speaker
samples and AUX2/AUX3 actuator samples on different physical devices.

Classify the raw streams from their actual channel contents. Remember streams
dominated by AUX1 as speaker sources and streams dominated by AUX2/AUX3 as
actuator sources. Once a real actuator source identifies the active raw PCM,
move only speaker-only streams to that same target. Combined speaker/haptic
streams remain untouched, and the behavior is limited to Death Stranding's
controller-effects mode.

---
 dlls/winepulse.drv/pulse.c | 85 ++++++++++++++++++++++++++++++++++++++++
 1 file changed, 85 insertions(+)

diff --git a/dlls/winepulse.drv/pulse.c b/dlls/winepulse.drv/pulse.c
index 4f8f9aff..a4ee44dd 100644
--- a/dlls/winepulse.drv/pulse.c
+++ b/dlls/winepulse.drv/pulse.c
@@ -149,6 +149,8 @@ static struct list g_phys_sources_removed = LIST_INIT(g_phys_sources_removed);
 static unsigned int g_haptic_hotplug_generation;
 /* separate list for holding removed devices that were just added */
 /* to avoid race-condition/deadlock. */
+    BOOL death_stranding_speaker_source;
+    BOOL death_stranding_actuator_source;
 static struct list g_phys_added_removed = LIST_INIT(g_phys_added_removed);
 
 static pthread_mutex_t pulse_mutex;
@@ -3343,6 +3345,86 @@ static NTSTATUS pulse_wow64_get_render_buffer(void *args)
     params32->result = params.result;
     *(unsigned int *)ULongToPtr(params32->data) = PtrToUlong(data);
     return STATUS_SUCCESS;
+static BOOL pulse_align_death_stranding_controller_stream(struct pulse_stream *stream,
+        const int16_t *samples, UINT32 frames)
+{
+    struct pulse_stream *other, *next;
+    unsigned int speaker_peak = 0, actuator_peak = 0;
+    const char *active_path = NULL;
+    UINT32 frame;
+
+    if (!use_death_stranding_controller_effects() || stream->ss.channels < 4 ||
+            !stream->dualsense_haptic_registered)
+        return FALSE;
+
+    for (frame = 0; frame < frames; ++frame)
+    {
+        int speaker = samples[frame * stream->ss.channels + 1];
+        int left = samples[frame * stream->ss.channels + 2];
+        int right = samples[frame * stream->ss.channels + 3];
+        unsigned int speaker_amplitude = speaker < 0 ? -speaker : speaker;
+        unsigned int left_amplitude = left < 0 ? -left : left;
+        unsigned int right_amplitude = right < 0 ? -right : right;
+
+        speaker_peak = max(speaker_peak, speaker_amplitude);
+        actuator_peak = max(actuator_peak, max(left_amplitude, right_amplitude));
+    }
+
+    if (speaker_peak >= 128 && speaker_peak > actuator_peak * 2)
+        stream->death_stranding_speaker_source = TRUE;
+    if (actuator_peak >= 512 && actuator_peak > speaker_peak * 2)
+        stream->death_stranding_actuator_source = TRUE;
+
+    if (stream->death_stranding_actuator_source && stream->haptic_alsa_path &&
+            stream->haptic_alsa_path[0])
+        active_path = stream->haptic_alsa_path;
+    else if (stream->death_stranding_speaker_source &&
+            !stream->death_stranding_actuator_source)
+    {
+        LIST_FOR_EACH_ENTRY(other, &dualsense_haptic_streams,
+                struct pulse_stream, dualsense_haptic_entry)
+        {
+            if (other->death_stranding_actuator_source && other->haptic_alsa_path &&
+                    other->haptic_alsa_path[0])
+            {
+                active_path = other->haptic_alsa_path;
+                break;
+            }
+        }
+    }
+
+    if (!active_path)
+        return FALSE;
+
+    if (stream->death_stranding_speaker_source &&
+            !stream->death_stranding_actuator_source &&
+            (!stream->haptic_alsa_path || strcmp(stream->haptic_alsa_path, active_path)))
+    {
+        TRACE("Moving Death Stranding speaker stream %p to active haptic target %s.\n",
+                stream, debugstr_a(active_path));
+        pulse_retarget_dualsense_haptic_stream_path(stream, active_path);
+        return TRUE;
+    }
+
+    if (stream->death_stranding_actuator_source)
+    {
+        LIST_FOR_EACH_ENTRY_SAFE(other, next, &dualsense_haptic_streams,
+                struct pulse_stream, dualsense_haptic_entry)
+        {
+            if (other == stream || !other->death_stranding_speaker_source ||
+                    other->death_stranding_actuator_source ||
+                    (other->haptic_alsa_path && !strcmp(other->haptic_alsa_path, active_path)))
+                continue;
+
+            TRACE("Moving Death Stranding speaker stream %p to active haptic target %s.\n",
+                    other, debugstr_a(active_path));
+            pulse_retarget_dualsense_haptic_stream_path(other, active_path);
+        }
+    }
+
+    return FALSE;
+}
+
 }
 
 static NTSTATUS pulse_wow64_get_capture_buffer(void *args)
@@ -3698,6 +3780,9 @@ static NTSTATUS pulse_wow64_set_volumes(void *args)
         PTR32 session_volumes;
     } *params32 = args;
     struct set_volumes_params params =
+    if (pulse_align_death_stranding_controller_stream(stream, write_data, frames))
+        return;
+
     {
         .stream = params32->stream,
         .master_volume = params32->master_volume,
