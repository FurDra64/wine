+/* Complete a pending HttpReceiveRequestEntityBody IRP from buffered opaque
+ * bytes. The caller must hold http_cs and guarantee conn->body_irp != NULL
+ * and conn->len != 0. */
+static void complete_opaque_body_irp(struct connection *conn)
+{
+    IRP *irp = conn->body_irp;
+    IO_STACK_LOCATION *stack = IoGetCurrentIrpStackLocation(irp);
+    const DWORD output_len = stack->Parameters.DeviceIoControl.OutputBufferLength;
+    ULONG len = min(conn->len, output_len);
+
+    TRACE("Completing opaque body IRP %p with %lu bytes.\n", irp, len);
+
+    IoSetCancelRoutine(irp, NULL);
+    conn->body_irp = NULL;
+    memcpy(irp->AssociatedIrp.SystemBuffer, conn->buffer, len);
+    memmove(conn->buffer, conn->buffer + len, conn->len - len);
+    conn->len -= len;
+    irp->IoStatus.Status = STATUS_SUCCESS;
+    irp->IoStatus.Information = len;
+    IoCompleteRequest(irp, IO_NO_INCREMENT);
+}
