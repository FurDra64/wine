+ * inbound frame head at a time; fragmented messages accumulate separately. */
+#define WS_INITIAL_WINDOW    4096
+#define WS_MAX_WINDOW        (8 * 1024 * 1024)
+#define WS_MAX_MESSAGE       (32 * 1024 * 1024)
+#define WS_MAX_CLOSE_REASON  123
