 VOID WINAPI WebSocketAbortHandle(WEB_SOCKET_HANDLE handle)
 {
+    struct websocket_handle *obj = get_handle_obj(handle);
+
     TRACE("(%p)\n", handle);
+
+    if (obj)
+        obj->aborted = TRUE;
 }
 
