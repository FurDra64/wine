+/* Queue one application send as a single serialized server-side frame.
+ * Only one send may be outstanding; a second WebSocketSend while one is
+ * pending fails. This DLL never touches sockets: the frame leaves the
+ * handle through GetAction (SEND_TO_NETWORK) for the host to write. */
+HRESULT WINAPI WebSocketSend(WEB_SOCKET_HANDLE handle,
+    WEB_SOCKET_BUFFER_TYPE bufferType, const WEB_SOCKET_BUFFER *buffer,
+    PVOID context)
+{
+    struct websocket_handle *obj = get_handle_obj(handle);
+    const BYTE *payload = NULL;
+    ULONG length = 0;
+    BYTE opcode = WS_OP_BINARY;
+    BOOL fin = TRUE;
+    BYTE *frame = NULL;
+    ULONG frame_len = 0;
+    BYTE close_payload[2 + WS_MAX_CLOSE_REASON];
+
+    TRACE("(%p, %d, %p, %p)\n", handle, bufferType, buffer, context);
+
+    if (!obj)
+        return E_HANDLE;
+    if (!valid_buffer_type(bufferType))
+        return E_INVALIDARG;
+    if (obj->aborted)
+        return E_HANDLE;
+    if (obj->close_sent)
+    {
+        WARN("send after close on handle %p\n", handle);
+        return E_INVALIDARG;
+    }
+    if (obj->send_pending)
+    {
+        WARN("send already pending on handle %p\n", handle);
+        return E_INVALIDARG;
+    }
+
+    switch (bufferType)
+    {
+    case WEB_SOCKET_CLOSE_BUFFER_TYPE:
+    {
+        USHORT status = WEB_SOCKET_SUCCESS_CLOSE_STATUS;
+
+        if (buffer)
+        {
+            status = buffer->CloseStatus.usStatus
+                ? buffer->CloseStatus.usStatus
+                : WEB_SOCKET_SUCCESS_CLOSE_STATUS;
+            payload = buffer->CloseStatus.pbReason;
+            length = buffer->CloseStatus.ulReasonLength;
+            if (length > WS_MAX_CLOSE_REASON)
+                return E_INVALIDARG;
+        }
+        close_payload[0] = (BYTE)(status >> 8);
+        close_payload[1] = (BYTE)status;
+        if (length)
+            memcpy(close_payload + 2, payload, length);
+        payload = close_payload;
+        length += 2;
+        opcode = WS_OP_CLOSE;
+        obj->close_sent = TRUE;
+        break;
+    }
+    case WEB_SOCKET_PING_PONG_BUFFER_TYPE:
+        if (buffer)
+        {
+            payload = buffer->Data.pbBuffer;
+            length = buffer->Data.ulBufferLength;
+        }
+        if (length > WS_MAX_CLOSE_REASON + 2)
+            return E_INVALIDARG;
+        opcode = WS_OP_PING;
+        break;
+    case WEB_SOCKET_UNSOLICITED_PONG_BUFFER_TYPE:
+        if (buffer)
+        {
+            payload = buffer->Data.pbBuffer;
+            length = buffer->Data.ulBufferLength;
+        }
+        if (length > WS_MAX_CLOSE_REASON + 2)
+            return E_INVALIDARG;
+        opcode = WS_OP_PONG;
+        break;
+    default:
+        if (!buffer || (!buffer->Data.pbBuffer && buffer->Data.ulBufferLength))
+            return E_INVALIDARG;
+        payload = buffer->Data.pbBuffer;
+        length = buffer->Data.ulBufferLength;
+        if (bufferType == WEB_SOCKET_UTF8_MESSAGE_BUFFER_TYPE
+            || bufferType == WEB_SOCKET_UTF8_FRAGMENT_BUFFER_TYPE)
+            opcode = WS_OP_TEXT;
+        if (bufferType == WEB_SOCKET_UTF8_FRAGMENT_BUFFER_TYPE
+            || bufferType == WEB_SOCKET_BINARY_FRAGMENT_BUFFER_TYPE)
+        {
+            /* A fragment continues (or starts) a fragmented message and
+             * is never final; a MESSAGE type terminates the sequence. */
+            fin = FALSE;
+            if (obj->send_frag_active)
+                opcode = WS_OP_CONTINUATION;
+            obj->send_frag_active = TRUE;
+        }
+        else
+        {
+            if (obj->send_frag_active)
+                opcode = WS_OP_CONTINUATION;
+            obj->send_frag_active = FALSE;
+        }
+        break;
+    }
+
+    if (FAILED(build_frame(opcode, fin, payload, length, &frame, &frame_len)))
+        return E_OUTOFMEMORY;
+    obj->send_frame = frame;
+    obj->send_frame_len = frame_len;
+    obj->send_frame_off = 0;
+    obj->send_type = bufferType;
+    obj->send_context = context;
+    obj->send_pending = TRUE;
+    return S_OK;
+}
+
+/* Register one receive operation. Only one receive may be outstanding; a
+ * second WebSocketReceive while one is pending fails. The payload itself
+ * arrives in two phases: RECEIVE_FROM_NETWORK hands the caller our wire
+ * window to fill, INDICATE_RECEIVE_COMPLETE hands back the parsed message. */
+HRESULT WINAPI WebSocketReceive(WEB_SOCKET_HANDLE handle,
+    WEB_SOCKET_BUFFER *buffer, PVOID context)
+{
+    struct websocket_handle *obj = get_handle_obj(handle);
+    WEB_SOCKET_BUFFER *copy = NULL;
+
+    TRACE("(%p, %p, %p)\n", handle, buffer, context);
+
+    if (!obj)
+        return E_HANDLE;
+    if (obj->aborted)
+        return E_HANDLE;
+    if (obj->recv_pending)
+    {
+        WARN("receive already pending on handle %p\n", handle);
+        return E_INVALIDARG;
+    }
+    /* The caller keeps its buffer alive until the indication completes, so
+     * only the struct is copied; the payload pointer stays borrowed and is
+     * never freed by this DLL. */
+    if (buffer)
+    {
+        copy = malloc(sizeof(*copy));
+        if (!copy)
+            return E_OUTOFMEMORY;
+        *copy = *buffer;
+    }
+    free(obj->recv_buffer);
+    obj->recv_buffer = copy;
+    obj->recv_context = context;
+    obj->recv_pending = TRUE;
+    return S_OK;
+}
+
+/* Fill the caller's buffer array with one network action. The returned
+ * pointers are borrowed: valid until the matching CompleteAction. */
+static HRESULT offer_network(struct websocket_handle *obj,
+    WEB_SOCKET_BUFFER *dataBuffers, ULONG *dataBufferCount,
+    WEB_SOCKET_BUFFER_TYPE *bufferType, PVOID *appContext,
+    PVOID *actionContext, WEB_SOCKET_ACTION *action,
+    enum ws_action_kind kind, BYTE *base, ULONG length, PVOID context)
+{
+    struct ws_action_ctx *ctx = malloc(sizeof(*ctx));
+
+    TRACE("action %d length %lu\n", kind, length);
+
+    if (!ctx)
+        return E_OUTOFMEMORY;
+    if (*dataBufferCount < 1)
+    {
+        free(ctx);
+        return E_INVALIDARG;
+    }
+    ctx->kind = kind;
+    ctx->length = length;
+    dataBuffers[0].BufferType = 0;
+    dataBuffers[0].Data.pbBuffer = base;
+    dataBuffers[0].Data.ulBufferLength = length;
+    *dataBufferCount = 1;
+    *bufferType = 0;
+    if (appContext)
+        *appContext = context;
+    *actionContext = ctx;
+    obj->out_action = ctx;
+    *action = (kind == WS_ACTION_RECV_NET)
+        ? WEB_SOCKET_RECEIVE_FROM_NETWORK_ACTION
+        : WEB_SOCKET_SEND_TO_NETWORK_ACTION;
+    return S_OK;
+}
+
+/* Offer the parsed inbound message (or close) for indication. Prefers the
+ * application's receive buffer when it fits; otherwise the borrowed
+ * handle-owned payload is returned for the caller to copy out. */
+static HRESULT offer_indicate(struct websocket_handle *obj,
+    WEB_SOCKET_BUFFER *dataBuffers, ULONG *dataBufferCount,
+    WEB_SOCKET_BUFFER_TYPE *bufferType, PVOID *appContext,
+    PVOID *actionContext, WEB_SOCKET_ACTION *action, BOOL is_close)
+{
+    struct ws_action_ctx *ctx = malloc(sizeof(*ctx));
+    BYTE *payload;
+    ULONG length;
+
+    if (!ctx)
+        return E_OUTOFMEMORY;
+    if (*dataBufferCount < 1)
+    {
+        free(ctx);
+        return E_INVALIDARG;
+    }
+    if (is_close)
+    {
+        payload = obj->close_ind_reason;
+        length = obj->close_ind_reason_len;
+    }
+    else
+    {
+        payload = obj->pending_msg->payload;
+        length = obj->pending_msg->length;
+    }
+    ctx->kind = is_close ? WS_ACTION_INDICATE_CLOSE : WS_ACTION_INDICATE_RECV;
+    ctx->length = length;
+    if (obj->recv_buffer && obj->recv_buffer->Data.pbBuffer
+        && obj->recv_buffer->Data.ulBufferLength >= length)
+    {
+        if (length)
+            memcpy(obj->recv_buffer->Data.pbBuffer, payload, length);
+        dataBuffers[0].Data.pbBuffer = obj->recv_buffer->Data.pbBuffer;
+        dataBuffers[0].Data.ulBufferLength = length;
+    }
+    else
+    {
+        dataBuffers[0].Data.pbBuffer = payload;
+        dataBuffers[0].Data.ulBufferLength = length;
+    }
+    if (is_close)
+    {
+        dataBuffers[0].BufferType = WEB_SOCKET_CLOSE_BUFFER_TYPE;
+        dataBuffers[0].CloseStatus.pbReason = dataBuffers[0].Data.pbBuffer;
+        dataBuffers[0].CloseStatus.ulReasonLength = length;
+        dataBuffers[0].CloseStatus.usStatus = obj->close_ind_status;
+        *bufferType = WEB_SOCKET_CLOSE_BUFFER_TYPE;
+    }
+    else
+    {
+        dataBuffers[0].BufferType = obj->pending_msg->type;
+        *bufferType = obj->pending_msg->type;
+    }
+    *dataBufferCount = 1;
+    if (appContext)
+        *appContext = obj->recv_context;
+    *actionContext = ctx;
+    obj->out_action = ctx;
+    *action = WEB_SOCKET_INDICATE_RECEIVE_COMPLETE_ACTION;
+    return S_OK;
+}
+
+HRESULT WINAPI WebSocketGetAction(WEB_SOCKET_HANDLE handle,
+    WEB_SOCKET_ACTION_QUEUE actionQueue, WEB_SOCKET_BUFFER *dataBuffers,
+    ULONG *dataBufferCount, WEB_SOCKET_ACTION *action,
+    WEB_SOCKET_BUFFER_TYPE *bufferType, PVOID *appContext, PVOID *actionContext)
+{
+    struct websocket_handle *obj = get_handle_obj(handle);
+    HRESULT hr;
+
+    TRACE("(%p, %d, %p, %p, %p, %p, %p, %p)\n", handle, actionQueue,
+        dataBuffers, dataBufferCount, action, bufferType, appContext,
+        actionContext);
+
+    if (!obj)
+        return E_HANDLE;
+    if (actionQueue != WEB_SOCKET_SEND_ACTION_QUEUE
+        && actionQueue != WEB_SOCKET_RECEIVE_ACTION_QUEUE
+        && actionQueue != WEB_SOCKET_ALL_ACTION_QUEUE)
+        return E_INVALIDARG;
+    if (!dataBuffers || !dataBufferCount || !action || !bufferType
+        || !actionContext)
+        return E_INVALIDARG;
+    if (obj->aborted || obj->out_action)
+    {
+        *action = WEB_SOCKET_NO_ACTION;
+        return S_OK;
+    }
+    if (obj->recv_pending && actionQueue != WEB_SOCKET_SEND_ACTION_QUEUE)
+        parse_available(obj);
+
+    if ((actionQueue == WEB_SOCKET_SEND_ACTION_QUEUE
+            || actionQueue == WEB_SOCKET_ALL_ACTION_QUEUE)
+        && obj->send_pending
+        && obj->send_frame_off < obj->send_frame_len)
+        return offer_network(obj, dataBuffers, dataBufferCount, bufferType,
+            appContext, actionContext, action, WS_ACTION_SEND_NET,
+            obj->send_frame + obj->send_frame_off,
+            obj->send_frame_len - obj->send_frame_off, obj->send_context);
+
+    if (actionQueue != WEB_SOCKET_SEND_ACTION_QUEUE && obj->pong_frame)
+        return offer_network(obj, dataBuffers, dataBufferCount, bufferType,
+            appContext, actionContext, action, WS_ACTION_PONG_NET,
+            obj->pong_frame + obj->pong_frame_off,
+            obj->pong_frame_len - obj->pong_frame_off, NULL);
+
+    if (actionQueue != WEB_SOCKET_SEND_ACTION_QUEUE && obj->close_frame)
+        return offer_network(obj, dataBuffers, dataBufferCount, bufferType,
+            appContext, actionContext, action, WS_ACTION_CLOSE_NET,
+            obj->close_frame + obj->close_frame_off,
+            obj->close_frame_len - obj->close_frame_off, NULL);
+
+    if (actionQueue != WEB_SOCKET_SEND_ACTION_QUEUE && obj->recv_pending
+        && obj->pending_msg)
+        return offer_indicate(obj, dataBuffers, dataBufferCount, bufferType,
+            appContext, actionContext, action, FALSE);
+
+    if (actionQueue != WEB_SOCKET_SEND_ACTION_QUEUE && obj->recv_pending
+        && obj->close_ind_pending)
+        return offer_indicate(obj, dataBuffers, dataBufferCount, bufferType,
+            appContext, actionContext, action, TRUE);
+
+    if (actionQueue != WEB_SOCKET_SEND_ACTION_QUEUE && obj->recv_pending
+        && !obj->aborted)
+    {
+        ULONG spare;
+
+        compact_window(obj);
+        spare = obj->recv_cap - obj->recv_len;
+        if (!spare)
+        {
+            hr = grow_window(obj);
+            if (FAILED(hr))
+            {
+                WARN("receive window exhausted\n");
+                obj->aborted = TRUE;
+                return hr;
+            }
+            spare = obj->recv_cap - obj->recv_len;
+        }
+        return offer_network(obj, dataBuffers, dataBufferCount, bufferType,
+            appContext, actionContext, action, WS_ACTION_RECV_NET,
+            obj->recv_buf + obj->recv_len, spare, NULL);
+    }
+
+    if ((actionQueue == WEB_SOCKET_SEND_ACTION_QUEUE
+            || actionQueue == WEB_SOCKET_ALL_ACTION_QUEUE)
+        && obj->send_pending
+        && obj->send_frame_off >= obj->send_frame_len)
+    {
+        struct ws_action_ctx *ctx = malloc(sizeof(*ctx));
+
+        if (!ctx)
+            return E_OUTOFMEMORY;
+        ctx->kind = WS_ACTION_INDICATE_SEND;
+        ctx->length = 0;
+        *dataBufferCount = 0;
+        *bufferType = obj->send_type;
+        if (appContext)
+            *appContext = obj->send_context;
+        *actionContext = ctx;
+        obj->out_action = ctx;
+        *action = WEB_SOCKET_INDICATE_SEND_COMPLETE_ACTION;
+        return S_OK;
+    }
+
+    *action = WEB_SOCKET_NO_ACTION;
+    return S_OK;
+}
+
+/* Resolve one outstanding action. Network actions must report exactly the
+ * offered byte count: a short/over write is a transport failure and aborts
+ * the handle, while a zero-byte receive means the peer went away and only
+ * cancels the pending receive. Indicate completions release the indicated
+ * state; a receive completes exactly one indication per WebSocketReceive. */
+VOID WINAPI WebSocketCompleteAction(WEB_SOCKET_HANDLE handle,
+    PVOID actionContext, ULONG bytesTransferred)
+{
+    struct websocket_handle *obj = get_handle_obj(handle);
+    struct ws_action_ctx *ctx;
+
+    TRACE("(%p, %p, %lu)\n", handle, actionContext, bytesTransferred);
+
+    if (!obj || !actionContext || actionContext != obj->out_action)
+    {
+        WARN("stale or foreign action context %p on handle %p\n",
+            actionContext, handle);
+        return;
+    }
+    ctx = obj->out_action;
+    obj->out_action = NULL;
+
+    switch (ctx->kind)
+    {
+    case WS_ACTION_SEND_NET:
+        if (bytesTransferred != ctx->length)
+        {
+            WARN("send length mismatch: %lu vs %lu\n",
+                bytesTransferred, ctx->length);
+            obj->aborted = TRUE;
+            break;
+        }
+        obj->send_frame_off += bytesTransferred;
+        break;
+    case WS_ACTION_PONG_NET:
+        if (bytesTransferred != ctx->length)
+        {
+            WARN("pong length mismatch: %lu vs %lu\n",
+                bytesTransferred, ctx->length);
+            obj->aborted = TRUE;
+            break;
+        }
+        obj->pong_frame_off += bytesTransferred;
+        if (obj->pong_frame_off >= obj->pong_frame_len)
+        {
+            free(obj->pong_frame);
+            obj->pong_frame = NULL;
+            obj->pong_frame_len = obj->pong_frame_off = 0;
+        }
+        break;
+    case WS_ACTION_CLOSE_NET:
+        if (bytesTransferred != ctx->length)
+        {
+            WARN("close length mismatch: %lu vs %lu\n",
+                bytesTransferred, ctx->length);
+            obj->aborted = TRUE;
+            break;
+        }
+        obj->close_frame_off += bytesTransferred;
+        if (obj->close_frame_off >= obj->close_frame_len)
+        {
+            free(obj->close_frame);
+            obj->close_frame = NULL;
+            obj->close_frame_len = obj->close_frame_off = 0;
+        }
+        break;
+    case WS_ACTION_RECV_NET:
+        if (!bytesTransferred)
+        {
+            /* End of stream: cancel the pending receive. */
+            TRACE("zero-byte receive, cancelling pending receive\n");
+            obj->recv_pending = FALSE;
+            free(obj->recv_buffer);
+            obj->recv_buffer = NULL;
+            break;
+        }
+        if (obj->recv_len + bytesTransferred > obj->recv_cap)
+        {
+            WARN("receive overrun: %lu + %lu\n",
+                obj->recv_len, bytesTransferred);
+            obj->aborted = TRUE;
+            break;
+        }
+        obj->recv_len += bytesTransferred;
+        parse_available(obj);
+        break;
+    case WS_ACTION_INDICATE_RECV:
+        free_message(obj->pending_msg);
+        obj->pending_msg = NULL;
+        obj->recv_pending = FALSE;
+        free(obj->recv_buffer);
+        obj->recv_buffer = NULL;
+        break;
+    case WS_ACTION_INDICATE_CLOSE:
+        free(obj->close_ind_reason);
+        obj->close_ind_reason = NULL;
+        obj->close_ind_reason_len = 0;
+        obj->close_ind_pending = FALSE;
+        obj->recv_pending = FALSE;
+        free(obj->recv_buffer);
+        obj->recv_buffer = NULL;
+        break;
+    case WS_ACTION_INDICATE_SEND:
+        free(obj->send_frame);
+        obj->send_frame = NULL;
+        obj->send_frame_len = obj->send_frame_off = 0;
+        obj->send_context = NULL;
+        obj->send_pending = FALSE;
+        break;
+    }
+    free(ctx);
+}
