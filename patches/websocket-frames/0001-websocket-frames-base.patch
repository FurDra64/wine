+/* Kinds of outstanding GetAction actions. Exactly one action may be
+ * outstanding per handle; its context is handed to the application and
+ * must come back via WebSocketCompleteAction before the next GetAction
+ * returns anything but NO_ACTION. */
+enum ws_action_kind
+{
+    WS_ACTION_SEND_NET,
+    WS_ACTION_PONG_NET,
+    WS_ACTION_CLOSE_NET,
+    WS_ACTION_RECV_NET,
+    WS_ACTION_INDICATE_RECV,
+    WS_ACTION_INDICATE_CLOSE,
+    WS_ACTION_INDICATE_SEND,
+};
+
+struct ws_action_ctx
+{
+    enum ws_action_kind kind;
+    ULONG length; /* wire bytes offered (network actions) */
+};
