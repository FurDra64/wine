+static BOOL valid_buffer_type(WEB_SOCKET_BUFFER_TYPE type)
+{
+    switch (type)
+    {
+    case WEB_SOCKET_UTF8_MESSAGE_BUFFER_TYPE:
+    case WEB_SOCKET_UTF8_FRAGMENT_BUFFER_TYPE:
+    case WEB_SOCKET_BINARY_MESSAGE_BUFFER_TYPE:
+    case WEB_SOCKET_BINARY_FRAGMENT_BUFFER_TYPE:
+    case WEB_SOCKET_CLOSE_BUFFER_TYPE:
+    case WEB_SOCKET_PING_PONG_BUFFER_TYPE:
+    case WEB_SOCKET_UNSOLICITED_PONG_BUFFER_TYPE:
+        return TRUE;
+    default:
+        return FALSE;
+    }
+}
+
+/* Serialize one server-side (unmasked) frame. Returns an owned buffer. */
+static HRESULT build_frame(BYTE opcode, BOOL fin, const BYTE *payload,
+    ULONG length, BYTE **out, ULONG *out_len)
+{
+    BYTE *frame;
+    ULONG hdr = 2;
+
+    if (length >= 126)
+        hdr += (length > 0xffff) ? 8 : 2;
+    frame = malloc(hdr + length);
+    if (!frame)
+        return E_OUTOFMEMORY;
+    frame[0] = opcode | (fin ? 0x80 : 0x00);
+    if (length < 126)
+    {
+        frame[1] = (BYTE)length;
+    }
+    else if (length <= 0xffff)
+    {
+        frame[1] = 126;
+        frame[2] = (BYTE)(length >> 8);
+        frame[3] = (BYTE)length;
+    }
+    else
+    {
+        frame[1] = 127;
+        frame[2] = frame[3] = frame[4] = frame[5] = 0;
+        frame[6] = (BYTE)(length >> 24);
+        frame[7] = (BYTE)(length >> 16);
+        frame[8] = (BYTE)(length >> 8);
+        frame[9] = (BYTE)length;
+    }
+    if (length && payload)
+        memcpy(frame + hdr, payload, length);
+    *out = frame;
+    *out_len = hdr + length;
+    return S_OK;
+}
+
+/* Drop consumed wire bytes and slide the remainder to the front. */
+static void compact_window(struct websocket_handle *obj)
+{
+    if (!obj->recv_off)
+        return;
+    if (obj->recv_off < obj->recv_len)
+        memmove(obj->recv_buf, obj->recv_buf + obj->recv_off,
+            obj->recv_len - obj->recv_off);
+    obj->recv_len -= obj->recv_off;
+    obj->recv_off = 0;
+}
+
+/* Grow the receive window so GetAction can offer spare bytes. */
+static HRESULT grow_window(struct websocket_handle *obj)
+{
+    ULONG new_cap = obj->recv_cap ? obj->recv_cap * 2 : WS_INITIAL_WINDOW;
+    BYTE *new_buf;
+
+    if (new_cap > WS_MAX_WINDOW)
+        new_cap = WS_MAX_WINDOW;
+    if (new_cap <= obj->recv_cap)
+        return E_OUTOFMEMORY;
+    new_buf = realloc(obj->recv_buf, new_cap);
+    if (!new_buf)
+        return E_OUTOFMEMORY;
+    obj->recv_buf = new_buf;
+    obj->recv_cap = new_cap;
+    return S_OK;
+}
+
+/* Queue a complete inbound data message. The payload is copied. */
+static HRESULT queue_message(struct websocket_handle *obj,
+    WEB_SOCKET_BUFFER_TYPE type, const BYTE *payload, ULONG length)
+{
+    struct ws_message *msg = malloc(sizeof(*msg));
+
+    if (!msg)
+        return E_OUTOFMEMORY;
+    msg->type = type;
+    msg->length = length;
+    msg->payload = NULL;
+    if (length)
+    {
+        msg->payload = malloc(length);
+        if (!msg->payload)
+        {
+            free(msg);
+            return E_OUTOFMEMORY;
+        }
+        memcpy(msg->payload, payload, length);
+    }
+    obj->pending_msg = msg;
+    return S_OK;
+}
+
+/* Append an unmasked payload chunk to the fragment accumulator. */
+static HRESULT append_fragment(struct websocket_handle *obj,
+    const BYTE *payload, ULONG length)
+{
+    BYTE *new_buf;
+    ULONG new_len = obj->frag_len + length;
+
+    if (new_len < obj->frag_len || new_len > WS_MAX_MESSAGE)
+        return E_OUTOFMEMORY;
+    if (new_len > obj->frag_cap)
+    {
+        ULONG new_cap = obj->frag_cap ? obj->frag_cap * 2 : 1024;
+
+        while (new_cap < new_len)
+            new_cap *= 2;
+        if (new_cap > WS_MAX_MESSAGE)
+            new_cap = WS_MAX_MESSAGE;
+        if (new_cap < new_len)
+            return E_OUTOFMEMORY;
+        new_buf = realloc(obj->frag_buf, new_cap);
+        if (!new_buf)
+            return E_OUTOFMEMORY;
+        obj->frag_buf = new_buf;
+        obj->frag_cap = new_cap;
+    }
+    if (length)
+        memcpy(obj->frag_buf + obj->frag_len, payload, length);
+    obj->frag_len = new_len;
+    return S_OK;
+}
+
+static void abort_handle(struct websocket_handle *obj)
+{
+    WARN("protocol error, aborting handle %p\n", obj);
+    obj->aborted = TRUE;
+}
+
+/* Answer an inbound ping with a pong carrying the same payload. */
+static void queue_pong(struct websocket_handle *obj,
+    const BYTE *payload, ULONG length)
+{
+    BYTE *frame = NULL;
+    ULONG frame_len = 0;
+
+    if (FAILED(build_frame(WS_OP_PONG, TRUE, payload, length, &frame, &frame_len)))
+    {
+        WARN("out of memory building pong\n");
+        obj->aborted = TRUE;
+        return;
+    }
+    free(obj->pong_frame);
+    obj->pong_frame = frame;
+    obj->pong_frame_len = frame_len;
+    obj->pong_frame_off = 0;
+}
+
+/* Handle one complete inbound close frame: latch the close indication and
+ * queue a close reply echoing the status and reason. */
+static void handle_close_frame(struct websocket_handle *obj,
+    const BYTE *payload, ULONG length)
+{
+    USHORT status = WEB_SOCKET_SUCCESS_CLOSE_STATUS;
+    ULONG reason_len = 0;
+    const BYTE *reason = NULL;
+    BYTE *frame = NULL, close_payload[2 + WS_MAX_CLOSE_REASON];
+    ULONG frame_len = 0, close_len;
+
+    if (length >= 2)
+    {
+        status = (USHORT)((payload[0] << 8) | payload[1]);
+        reason = payload + 2;
+        reason_len = length - 2;
+        if (reason_len > WS_MAX_CLOSE_REASON)
+            reason_len = WS_MAX_CLOSE_REASON;
+    }
+    TRACE("close received status %u reason_len %lu\n", status, reason_len);
+
+    free(obj->close_ind_reason);
+    obj->close_ind_reason = NULL;
+    obj->close_ind_reason_len = 0;
+    if (reason_len)
+    {
+        obj->close_ind_reason = malloc(reason_len);
+        if (!obj->close_ind_reason)
+        {
+            WARN("out of memory storing close reason\n");
+            obj->aborted = TRUE;
+            return;
+        }
+        memcpy(obj->close_ind_reason, reason, reason_len);
+        obj->close_ind_reason_len = reason_len;
+    }
+    obj->close_ind_status = status;
+    obj->close_ind_pending = TRUE;
+    obj->close_received = TRUE;
+
+    if (!obj->close_sent)
+    {
+        close_payload[0] = (BYTE)(status >> 8);
+        close_payload[1] = (BYTE)status;
+        if (reason_len)
+            memcpy(close_payload + 2, reason, reason_len);
+        close_len = 2 + reason_len;
+        if (FAILED(build_frame(WS_OP_CLOSE, TRUE, close_payload, close_len,
+                &frame, &frame_len)))
+        {
+            WARN("out of memory building close reply\n");
+            obj->aborted = TRUE;
+            return;
+        }
+        free(obj->close_frame);
+        obj->close_frame = frame;
+        obj->close_frame_len = frame_len;
+        obj->close_frame_off = 0;
+        obj->close_sent = TRUE;
+    }
+}
+
+/* Process one complete data frame payload (already unmasked into a
+ * temporary copy). Advances fragmentation or queues a message. */
+static void handle_data_frame(struct websocket_handle *obj, BYTE opcode,
+    BOOL fin, const BYTE *payload, ULONG length)
+{
+    WEB_SOCKET_BUFFER_TYPE base;
+
+    if (opcode == WS_OP_CONTINUATION)
+    {
+        if (!obj->frag_active)
+        {
+            abort_handle(obj);
+            return;
+        }
+        if (FAILED(append_fragment(obj, payload, length)))
+        {
+            WARN("out of memory accumulating fragment\n");
+            obj->aborted = TRUE;
+            return;
+        }
+        if (fin)
+        {
+            if (FAILED(queue_message(obj, obj->frag_type,
+                    obj->frag_buf, obj->frag_len)))
+            {
+                WARN("out of memory queueing reassembled message\n");
+                obj->aborted = TRUE;
+                return;
+            }
+            free(obj->frag_buf);
+            obj->frag_buf = NULL;
+            obj->frag_len = obj->frag_cap = 0;
+            obj->frag_active = FALSE;
+        }
+        return;
+    }
+
+    if (obj->frag_active)
+    {
+        abort_handle(obj);
+        return;
+    }
+    base = (opcode == WS_OP_TEXT) ? WEB_SOCKET_UTF8_MESSAGE_BUFFER_TYPE
+        : WEB_SOCKET_BINARY_MESSAGE_BUFFER_TYPE;
+    if (fin)
+    {
+        if (FAILED(queue_message(obj, base, payload, length)))
+        {
+            WARN("out of memory queueing message\n");
+            obj->aborted = TRUE;
+        }
+        return;
+    }
+    obj->frag_type = base;
+    obj->frag_active = TRUE;
+    free(obj->frag_buf);
+    obj->frag_buf = NULL;
+    obj->frag_len = obj->frag_cap = 0;
+    if (FAILED(append_fragment(obj, payload, length)))
+    {
+        WARN("out of memory starting fragment\n");
+        obj->aborted = TRUE;
+        obj->frag_active = FALSE;
+    }
+}
+
+/* Parse complete frames out of the receive window. Stops when the window
+ * holds no complete frame or when a message is ready for indication.
+ * Data past a received close is consumed and ignored; control frames stay
+ * interleaved correctly because they never touch fragment state. */
+static void parse_available(struct websocket_handle *obj)
+{
+    ULONG off = obj->recv_off;
+    BYTE *unmasked = NULL;
+
+    while (!obj->pending_msg && !obj->aborted)
+    {
+        BYTE b0, b1, opcode;
+        BOOL fin, masked;
+        ULONG hdr = 2, length = 0, i;
+        const BYTE *payload, *key = NULL;
+
+        if (obj->recv_len - off < 2)
+            break;
+        b0 = obj->recv_buf[off];
+        b1 = obj->recv_buf[off + 1];
+        fin = (b0 & 0x80) != 0;
+        opcode = b0 & 0x0f;
+        masked = (b1 & 0x80) != 0;
+        if (b0 & 0x70)
+        {
+            abort_handle(obj);
+            break;
+        }
+        if ((b1 & 0x7f) < 126)
+        {
+            length = b1 & 0x7f;
+        }
+        else if ((b1 & 0x7f) == 126)
+        {
+            if (obj->recv_len - off < 4)
+                break;
+            length = ((ULONG)obj->recv_buf[off + 2] << 8)
+                | obj->recv_buf[off + 3];
+            hdr = 4;
+        }
+        else
+        {
+            ULONG hi;
+
+            if (obj->recv_len - off < 10)
+                break;
+            hi = ((ULONG)obj->recv_buf[off + 2] << 24)
+                | ((ULONG)obj->recv_buf[off + 3] << 16)
+                | ((ULONG)obj->recv_buf[off + 4] << 8)
+                | obj->recv_buf[off + 5];
+            length = ((ULONG)obj->recv_buf[off + 6] << 24)
+                | ((ULONG)obj->recv_buf[off + 7] << 16)
+                | ((ULONG)obj->recv_buf[off + 8] << 8)
+                | obj->recv_buf[off + 9];
+            if (hi)
+            {
+                abort_handle(obj);
+                break;
+            }
+            hdr = 10;
+        }
+        if (masked)
+            hdr += 4;
+        if (length > WS_MAX_WINDOW)
+        {
+            /* Declared payload can never fit the window. */
+            abort_handle(obj);
+            break;
+        }
+        if (obj->recv_len - off < hdr + length)
+        {
+            if (obj->recv_off + hdr <= obj->recv_len
+                && obj->recv_len == obj->recv_cap)
+            {
+                /* Window full with a partial frame: grow so the rest fits. */
+                obj->recv_off = off;
+                if (FAILED(grow_window(obj)))
+                {
+                    WARN("receive window exhausted\n");
+                    obj->aborted = TRUE;
+                }
+                return;
+            }
+            break;
+        }
+        if (masked)
+            key = obj->recv_buf + off + hdr - 4;
+        payload = obj->recv_buf + off + hdr;
+        off += hdr + length;
+
+        if (opcode >= WS_OP_CLOSE)
+        {
+            if (!fin || length > WS_MAX_CLOSE_REASON + 2)
+            {
+                abort_handle(obj);
+                break;
+            }
+            if (opcode == WS_OP_PING)
+            {
+                if (length)
+                {
+                    unmasked = malloc(length);
+                    if (!unmasked)
+                    {
+                        WARN("out of memory for ping payload\n");
+                        obj->aborted = TRUE;
+                        break;
+                    }
+                    for (i = 0; i < length; i++)
+                        unmasked[i] = payload[i] ^ (masked ? key[i % 4] : 0);
+                    queue_pong(obj, unmasked, length);
+                    free(unmasked);
+                    unmasked = NULL;
+                }
+                else
+                    queue_pong(obj, NULL, 0);
+            }
+            else if (opcode == WS_OP_CLOSE)
+            {
+                if (length)
+                {
+                    unmasked = malloc(length);
+                    if (!unmasked)
+                    {
+                        WARN("out of memory for close payload\n");
+                        obj->aborted = TRUE;
+                        break;
+                    }
+                    for (i = 0; i < length; i++)
+                        unmasked[i] = payload[i] ^ (masked ? key[i % 4] : 0);
+                    handle_close_frame(obj, unmasked, length);
+                    free(unmasked);
+                    unmasked = NULL;
+                }
+                else
+                    handle_close_frame(obj, NULL, 0);
+            }
+            else if (opcode != WS_OP_PONG)
+            {
+                abort_handle(obj);
+                break;
+            }
+            /* Pong frames carry no information the API exposes; drop them. */
+            continue;
+        }
+
+        if (opcode != WS_OP_CONTINUATION && opcode != WS_OP_TEXT
+            && opcode != WS_OP_BINARY)
+        {
+            abort_handle(obj);
+            break;
+        }
+        if (obj->close_received)
+            continue; /* data after close is ignored */
+        if (length)
+        {
+            unmasked = malloc(length);
+            if (!unmasked)
+            {
+                WARN("out of memory for frame payload\n");
+                obj->aborted = TRUE;
+                break;
+            }
+            for (i = 0; i < length; i++)
+                unmasked[i] = payload[i] ^ (masked ? key[i % 4] : 0);
+            handle_data_frame(obj, opcode, fin, unmasked, length);
+            free(unmasked);
+            unmasked = NULL;
+        }
+        else
+            handle_data_frame(obj, opcode, fin, NULL, 0);
+    }
+    obj->recv_off = off;
+    compact_window(obj);
+}
