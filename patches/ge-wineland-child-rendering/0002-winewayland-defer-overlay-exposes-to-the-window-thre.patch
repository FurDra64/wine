From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Erhan Bilgili <nano.matters.code@gmail.com>
Date: Sun, 21 Jun 2026 14:57:45 +0200
Subject: [PATCH 02/49] winewayland: defer overlay exposes to the window thread

Wayland configure and scale callbacks can request a window surface
flush from the event thread. When a toplevel has child overlays, that
path can take the window surface lock before win_data_mutex, the opposite
order used while creating or repositioning windows, and deadlock.

Route those exposes through a private window message so they run on the owning
thread. Keep the initial configure flush inline for non-overlay windows, preserving
the existing path for one-shot GDI windows that may draw before they pump messages.
---
dlls/winewayland.drv/wayland_surface.c | 22 +++++++++++++++++-----
dlls/winewayland.drv/waylanddrv.h      |  1 +
dlls/winewayland.drv/window.c          | 33 ++++++++++++++++++++++++++++++++-
3 files changed, 50 insertions(+), 6 deletions(-)

diff --git a/dlls/winewayland.drv/wayland_surface.c b/dlls/winewayland.drv/wayland_surface.c
index b2219d52..03c8daef 100644
--- a/dlls/winewayland.drv/wayland_surface.c
+++ b/dlls/winewayland.drv/wayland_surface.c
@@ -40,6 +40,20 @@
 
 WINE_DEFAULT_DEBUG_CHANNEL(waylanddrv);
 
+static void request_window_surface_expose(HWND hwnd, BOOL allow_inline)
+{
+    /* Inline exposes preserve the initial-configure path for windows that draw
+     * without pumping messages. Child-overlay windows must defer to avoid the
+     * event thread taking the surface lock before win_data_mutex. */
+    if (allow_inline && !window_surface_needs_child_overlays(hwnd))
+    {
+        NtUserExposeWindowSurface(hwnd, 0, NULL);
+        return;
+    }
+
+    NtUserPostMessage(hwnd, WM_WAYLAND_EXPOSE, 0, 0);
+}
+
 struct wayland_hwnd_dmabuf_surface;
 
 struct wayland_hwnd_dmabuf_buffer
@@ -355,10 +369,7 @@ static void xdg_surface_handle_configure(void *private, struct xdg_surface *xdg_
 
     /* Flush the window surface in case there is content that we weren't
      * able to flush before due to the lack of the initial configure. */
-    if (initial_configure)
-    {
-        NtUserExposeWindowSurface(hwnd, 0, NULL);
-    }
+    if (initial_configure) request_window_surface_expose(hwnd, TRUE);
 }
 
 static const struct xdg_surface_listener xdg_surface_listener =
@@ -457,7 +468,8 @@ void wp_fractional_scale_handle_scale(void* user_data,
 
     wayland_win_data_release(data);
 
-    NtUserExposeWindowSurface(hwnd, 0, NULL);
+    request_window_surface_expose(hwnd, FALSE);
+    update_window_state(hwnd);
 }
 
 static const struct wp_fractional_scale_v1_listener wp_fractional_scale_listener =
diff --git a/dlls/winewayland.drv/waylanddrv.h b/dlls/winewayland.drv/waylanddrv.h
index f959e3bd..f202f8d1 100644
--- a/dlls/winewayland.drv/waylanddrv.h
+++ b/dlls/winewayland.drv/waylanddrv.h
@@ -73,6 +73,7 @@ enum wayland_window_message
     WM_WAYLAND_CONFIGURE,
     WM_WAYLAND_SET_FOREGROUND,
     WM_WAYLAND_DMABUF_FRAME,
+    WM_WAYLAND_EXPOSE,
 };
 
 enum wayland_surface_config_state
diff --git a/dlls/winewayland.drv/window.c b/dlls/winewayland.drv/window.c
index 1e941083..4b083d9b 100644
--- a/dlls/winewayland.drv/window.c
+++ b/dlls/winewayland.drv/window.c
@@ -795,8 +795,39 @@ LRESULT WAYLAND_DesktopWindowProc(HWND hwnd, UINT msg, WPARAM wp, LPARAM lp)
 }
 
     case WM_WAYLAND_DMABUF_FRAME:
-        /* Import a frame published for a descendant of this toplevel. */
+    {
+        struct child_overlay_snapshot *snapshot = NULL;
+
+        /* A producer published a frame for a descendant of this toplevel.
+         * Import it in the process that owns the toplevel's wayland surface.
+         * If GDI child overlays were captured before the producer existed,
+         * refresh them once with a producer-aware snapshot so stale host
+         * overlays do not stay stacked above the live dmabuf. */
+        if (window_surface_needs_dmabuf_overlay_refresh(hwnd))
+            snapshot = child_overlays_snapshot(hwnd);
         ensure_window_surface_contents(hwnd);
+        if (snapshot)
+        {
+            struct wayland_win_data *data;
+
+            if ((data = wayland_win_data_get(hwnd)))
+            {
+                if (data->wayland_surface)
+                {
+                    wayland_surface_apply_child_overlays(data->wayland_surface, NULL, snapshot);
+                    wl_surface_commit(data->wayland_surface->wl_surface);
+                    wl_display_flush(process_wayland.wl_display);
+                }
+                wayland_win_data_release(data);
+            }
+            free(snapshot);
+        }
+        return 0;
+    }
+    case WM_WAYLAND_EXPOSE:
+        /* Event-thread callbacks use this for exposes that must follow the
+         * window-thread lock order. */
+        NtUserExposeWindowSurface(hwnd, 0, NULL);
         return 0;
 /*****************************************************************
  *		WAYLAND_SetLayeredWindowAttributes
