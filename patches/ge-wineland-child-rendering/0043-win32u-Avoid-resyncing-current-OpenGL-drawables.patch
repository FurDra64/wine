From 556ec5704e5e44920286826cf0efed966b4698e Mon Sep 17 00:00:00 2001
From: Raphael Jakse <raphael.jakse@reactos.org>
Date: Tue, 7 Jul 2026 12:16:04 +0200
Subject: [PATCH 36/49] win32u: Avoid resyncing current OpenGL drawables.

Skip context drawable updates when the current draw and read drawables are
still attached to the same client surfaces and do not need a framebuffer
update. This avoids unnecessary surface lookups in the common steady-state
case where make_current is called repeatedly without drawable changes.

For convenience, also skip re-adding/releasing the same drawable pointer in
set_window_opengl_drawable when no pointer change occurred.

---
 dlls/win32u/opengl.c | 26 ++++++++++++++++++++++++--
 1 file changed, 24 insertions(+), 2 deletions(-)

diff --git a/dlls/win32u/opengl.c b/dlls/win32u/opengl.c
index ab0d38ef454..f6a8f15fb21 100644
@@ -2259,7 +2259,10 @@
     if (hwnd && (win = get_win_ptr( hwnd )) && win != WND_DESKTOP && win != WND_OTHER_PROCESS)
     {
         struct opengl_drawable **ptr = current ? &win->current_drawable : &win->unused_drawable;
-        old_drawable = *ptr;
-        if ((*ptr = new_drawable)) opengl_drawable_add_ref( new_drawable );
+        if (*ptr != new_drawable)
+        {
+            old_drawable = *ptr;
+            if ((*ptr = new_drawable)) opengl_drawable_add_ref( new_drawable );
+        }
         release_win_ptr( win );
     }
@@ -2747,11 +2747,30 @@
     /* get an updated drawable with the desired format */
     return get_window_unused_drawable( hwnd, format, FALSE );
 }
 
+static BOOL context_drawable_is_current( struct opengl_drawable *drawable )
+{
+    HWND hwnd;
+
+    if (!drawable || !drawable->client) return FALSE;
+    if (!(hwnd = drawable->client->hwnd)) return FALSE;
+    return get_client_surface_window( drawable->client ) == hwnd &&
+           !InterlockedCompareExchange( &drawable->client->updated, 0, 0 );
+}
+
+static BOOL context_drawables_are_current( struct opengl_context *context )
+{
+    if (!context_drawable_is_current( context->draw )) return FALSE;
+    return context->read == context->draw || context_drawable_is_current( context->read );
+}
+
 static BOOL context_sync_drawables( struct opengl_context *context, HDC draw_hdc, HDC read_hdc )
 {
     struct opengl_drawable *new_draw, *new_read, *old_draw = NULL, *old_read = NULL;
     struct opengl_context *previous = NtCurrentTeb()->glReserved2;
     BOOL ret;
+    if (!draw_hdc && !read_hdc && previous == context && context_drawables_are_current( context ))
+        return TRUE;
+
 
     if (!(new_draw = get_updated_drawable( draw_hdc, context->attrs.format, context->draw ))) return FALSE;
-- 
