From cd4699994c7a4e4562c7d91e86579930d831524d Mon Sep 17 00:00:00 2001
From: Erhan Bilgili <erhan.bilgili@gmail.com>
Date: Wed, 5 Aug 2026 16:15:41 +0200
Subject: [PATCH] winewayland: Unmap hidden toplevels.

Keeping an existing toplevel mapped after WS_VISIBLE is cleared can
remap an explicitly hidden launcher during later window updates. Its
stale input surface may then steal focus from a fullscreen game.

Restore role removal for invisible non-minimized windows while
retaining the minimized-window handling.

(cherry picked from commit cd4699994c7a4e4562c7d91e86579930d831524d)

[ GE-Proton adaptation: this base does not cache window style or the menu-popup/
  foreground hints in struct wayland_win_data, so the reverted keep-mapped state is
  dropped from wayland_win_data_create_wayland_surface() without reworking cached
  state. The swp_flags parameter is kept because GE-Proton's tray-menu and
  fullscreen-hide handling still needs it. ]

Source: https://github.com/nanomatters/wine-salkim/commit/cd4699994c7a4e4562c7d91e86579930d831524d
---
 dlls/winewayland.drv/window.c | 30 +++++++++++-------------------
 1 file changed, 11 insertions(+), 19 deletions(-)

diff --git a/dlls/winewayland.drv/window.c b/dlls/winewayland.drv/window.c
index 3901b9f42ec..409ea5d2548 100644
--- a/dlls/winewayland.drv/window.c
+++ b/dlls/winewayland.drv/window.c
@@ -255,21 +255,14 @@ static BOOL rect_intersects_virtual_screen(const RECT *rect)
     return intersect_rect(&intersect, rect, &virtual_rect);
 }
 
-static BOOL should_keep_toplevel_mapped(struct wayland_surface *surface,
-                                        DWORD style, UINT swp_flags)
+static BOOL should_keep_minimized_toplevel_mapped(struct wayland_surface *surface,
+                                                  DWORD style)
 {
-    UINT show_cmd;
-    BOOL keep_mapped;
-
     if (!surface || surface->role != WAYLAND_SURFACE_ROLE_TOPLEVEL) return FALSE;
-
-    keep_mapped = !surface->current.caps ||
-                  (surface->current.caps & WAYLAND_SURFACE_WM_CAPS_MINIMIZE);
-    if (swp_flags & (SWP_HIDEWINDOW | SWP_SHOWWINDOW)) return keep_mapped;
-    if (!(show_cmd = NtUserGetWindowLongW( surface->hwnd, GWL_STYLE ) & (WS_MINIMIZE | WS_VISIBLE)))
-        return keep_mapped;
-
-    return show_cmd == (WS_MINIMIZE | WS_VISIBLE) && !(swp_flags & SWP_FRAMECHANGED);
+    if (!(style & WS_MINIMIZE)) return FALSE;
+
+    return !surface->current.caps ||
+           (surface->current.caps & WAYLAND_SURFACE_WM_CAPS_MINIMIZE);
 }
 
 static BOOL window_or_root_minimized(HWND hwnd)
@@ -318,14 +314,13 @@ static BOOL wayland_win_data_create_wayland_surface(struct wayland_win_data *dat
     struct wayland_client_surface *client = data->client_surface;
     struct wayland_surface *surface;
     enum wayland_surface_role role;
-    BOOL visible, layer_set, keep_mapped, server_decor = FALSE;
+    BOOL visible, layer_set, server_decor = FALSE;
     DWORD exstyle = NtUserGetWindowLongW(data->hwnd, GWL_EXSTYLE);
     DWORD style = NtUserGetWindowLongW(data->hwnd, GWL_STYLE);
 
     TRACE("hwnd=%p\n", data->hwnd);
 
     surface = data->wayland_surface;
-    keep_mapped = should_keep_toplevel_mapped(surface, style, swp_flags);
 
     layer_set = !(exstyle & WS_EX_LAYERED) || data->layered_attribs_set;
     visible = ((style & WS_VISIBLE) == WS_VISIBLE);
@@ -341,7 +341,7 @@ static BOOL wayland_win_data_create_wayland_surface(struct wayland_win_data *dat

     if (visible && !owner_surface && !use_layer_shell && !toplevel_surface &&
         !rect_intersects_virtual_screen(&data->rects.window) &&
-        !keep_mapped)
+        !should_keep_minimized_toplevel_mapped(surface, style))
         visible = FALSE;
 
     if (!visible) role = WAYLAND_SURFACE_ROLE_NONE;
-- 
