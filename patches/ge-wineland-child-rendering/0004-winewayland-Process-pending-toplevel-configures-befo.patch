From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Erhan Bilgili <nano.matters.code@gmail.com>
Date: Mon, 22 Jun 2026 09:42:18 +0200
Subject: [PATCH 04/49] winewayland: Process pending toplevel configures before
 rawpos

Client-surface fullscreen transitions can flush contents from the raw
window-position path before the pending compositor configure has been
marked processed. In that case the xdg configure is not acked/promoted,
leaving the parent surface unconfigured and dmabuf-backed content invisible.

Treat pending compositor configures as authoritative until promotion, mark
them processed before rawpos can flush, and ensure contents afterwards if
rawpos did not promote the configure.
---
dlls/winewayland.drv/window.c | 30 ++++++++++++++++++++++++++++--
1 file changed, 28 insertions(+), 2 deletions(-)

diff --git a/dlls/winewayland.drv/window.c b/dlls/winewayland.drv/window.c
index b3ed4fa4..e9bd7563 100644
--- a/dlls/winewayland.drv/window.c
+++ b/dlls/winewayland.drv/window.c
@@ -283,8 +283,7 @@ static BOOL wayland_win_data_create_wayland_surface(struct wayland_win_data *dat
 
 static void wayland_surface_update_state_toplevel(struct wayland_surface *surface)
 {
-    BOOL processing_config = surface->processing.serial &&
-                             !surface->processing.processed;
+    BOOL processing_config = surface->processing.serial;
 
     TRACE("hwnd=%p window_state=%#x %s->state=%#x\n",
           surface->hwnd, surface->window.state,
@@ -330,6 +329,7 @@ static void wayland_surface_update_state_toplevel(struct wayland_surface *surfac
     }
     else
     {
+        /* Keep compositor configures authoritative until promotion. */
         surface->processing.processed = TRUE;
     }
 }
@@ -769,6 +769,32 @@ static void wayland_configure_window(HWND hwnd)
     }
 
     NtUserSetRawWindowPos(hwnd, rect, flags, FALSE);
+
+    /* Mark pending configures processed before rawpos can flush. */
+    if ((data = wayland_win_data_get(hwnd)))
+    {
+        surface = data->wayland_surface;
+        if (surface && surface->role == WAYLAND_SURFACE_ROLE_TOPLEVEL &&
+            surface->xdg_surface && surface->processing.serial &&
+            !surface->processing.processed)
+            wayland_win_data_update_wayland_state(data);
+        wayland_win_data_release(data);
+    }
+
+    /* Ack/promote the processed configure if rawpos did not flush it. */
+    if ((data = wayland_win_data_get(hwnd)))
+    {
+        surface = data->wayland_surface;
+        if (surface && surface->role == WAYLAND_SURFACE_ROLE_TOPLEVEL &&
+            surface->xdg_surface && surface->processing.serial &&
+            surface->processing.processed)
+        {
+            wayland_win_data_release(data);
+            /* Preserve flush lock order: surface before win_data. */
+            ensure_window_surface_contents(hwnd);
+        }
+        else wayland_win_data_release(data);
+    }
 }
 
