     enum wayland_surface_role role;
     BOOL visible;
@@ -266,6 +267,11 @@ static BOOL wayland_win_data_create_wayland_surface(struct wayland_win_data *dat
 
     wayland_win_data_get_config(data, &surface->window);
 
