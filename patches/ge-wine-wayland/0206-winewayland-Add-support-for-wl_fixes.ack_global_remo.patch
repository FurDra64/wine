From 6cca94b0ad00da5bcf784dfd85fc076410b57f32 Mon Sep 17 00:00:00 2001
From: Vlad Zahorodnii <vlad.zahorodnii@kde.org>
Date: Mon, 20 Jul 2026 15:30:31 -0400
Subject: [PATCH 206/285] winewayland: Add support for
 wl_fixes.ack_global_remove.

The wl_fixes.ack_global_remove request signals the compositor that the
client will not bind the removed global. It can be used by the
compositor to decide when it is safe to actually destroy the
corresponding global. If a global is destroyed too soon, some clients may
get disconnected.
---
 dlls/winewayland.drv/wayland.c    | 12 ++++++++++++
 dlls/winewayland.drv/waylanddrv.h |  1 +
 2 files changed, 13 insertions(+)
diff --git a/dlls/winewayland.drv/wayland.c b/dlls/winewayland.drv/wayland.c
index 118ee2d6..60a29025 100644
--- a/dlls/winewayland.drv/wayland.c
+++ b/dlls/winewayland.drv/wayland.c
@@ -270,6 +270,13 @@ static void registry_handle_global_remove(void *data, struct wl_registry *regist
         seat->global_id = 0;
         pthread_mutex_unlock(&seat->mutex);
     }
+#ifdef WL_FIXES_INTERFACE
+    else if (strcmp(interface, "wl_fixes") == 0)
+    {
+        if (version < 2) return;
+        process_wayland.wl_fixes = wl_registry_bind(registry, id, &wl_fixes_interface, 2);
+    }
+#endif
 }
 
 static const struct wl_registry_listener registry_listener = {
@@ -280,6 +287,11 @@ static const struct wl_registry_listener registry_listener = {
 /**********************************************************************
  *          wayland_process_init
  *
+#ifdef WL_FIXES_ACK_GLOBAL_REMOVE
+    if (process_wayland.wl_fixes)
+        wl_fixes_ack_global_remove(process_wayland.wl_fixes, registry, id);
+#endif
+
  *  Initialise the per process wayland objects.
  *
  */
diff --git a/dlls/winewayland.drv/waylanddrv.h b/dlls/winewayland.drv/waylanddrv.h
index 1cb525b2..c6c9f1d7 100644
--- a/dlls/winewayland.drv/waylanddrv.h
+++ b/dlls/winewayland.drv/waylanddrv.h
@@ -176,6 +176,7 @@ struct wayland
     struct wl_shm *wl_shm;
     struct wp_viewporter *wp_viewporter;
     struct wl_subcompositor *wl_subcompositor;
+    struct wl_fixes *wl_fixes;
     struct wp_fractional_scale_manager_v1 *wp_fractional_scale_manager_v1;
     struct zwp_pointer_constraints_v1 *zwp_pointer_constraints_v1;
     struct zwp_relative_pointer_manager_v1 *zwp_relative_pointer_manager_v1;
