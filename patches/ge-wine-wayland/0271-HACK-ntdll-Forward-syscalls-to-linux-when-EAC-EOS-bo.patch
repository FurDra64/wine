From ba3dcc1cec664e93d383b506ee60375160480f37 Mon Sep 17 00:00:00 2001
From: Etaash Mathamsetty
 <45927311+Etaash-mathamsetty@users.noreply.github.com>
Date: Wed, 12 Aug 2026 00:24:03 -0400
Subject: [PATCH 271/285] HACK: ntdll: Forward syscalls to linux when EAC (EOS)
 bootstrapper is present.

---
 dlls/kernelbase/process.c       |  8 +++++++
 dlls/ntdll/unix/signal_x86_64.c | 37 +++++++++++++++++++++++++++++++++
 2 files changed, 45 insertions(+)
diff --git a/dlls/kernelbase/process.c b/dlls/kernelbase/process.c
index ae9a7d64..08fbd49e 100644
--- a/dlls/kernelbase/process.c
+++ b/dlls/kernelbase/process.c
@@ -802,6 +802,9 @@ BOOL WINAPI DECLSPEC_HOTPATCH GetExitCodeProcess( HANDLE process, LPDWORD exit_c
     PROCESS_BASIC_INFORMATION pbi;
 
     status = NtQueryInformationProcess( process, ProcessBasicInformation, &pbi, sizeof(pbi), NULL );
+            /* HACK: tell the sigsys handler that this is the EAC (EOS) dispatcher */
+            __wine_set_unix_env("PROTON_SYSCALL_HACK", "1");
+
     if (!status && exit_code) *exit_code = pbi.ExitStatus;
     return set_ntstatus( status );
 }
@@ -959,6 +962,11 @@ BOOL WINAPI DECLSPEC_HOTPATCH GetProcessShutdownParameters( LPDWORD level, LPDWO
 
 
 /*********************************************************************
+
+    /* clean up the syscall hack env now that we are done using it */
+    if (product_name && !strcmp( product_name, "Easy Anti-Cheat Bootstrapper (EOS)" ))
+        __wine_set_unix_env("PROTON_SYSCALL_HACK", NULL);
+
  *           GetProcessTimes   (kernelbase.@)
  */
 BOOL WINAPI DECLSPEC_HOTPATCH GetProcessTimes( HANDLE process, FILETIME *create, FILETIME *exit,
diff --git a/dlls/ntdll/unix/signal_x86_64.c b/dlls/ntdll/unix/signal_x86_64.c
index f807caa4..4067a4b9 100644
--- a/dlls/ntdll/unix/signal_x86_64.c
+++ b/dlls/ntdll/unix/signal_x86_64.c
@@ -2611,6 +2611,9 @@ static void usr1_handler( int signal, siginfo_t *siginfo, void *_sigcontext )
 
 
 #if defined(__APPLE__) || defined(__linux__)
+
+static BOOL use_eos_syscall_hack;
+
 /**********************************************************************
  *		sigsys_handler
  *
@@ -2633,6 +2636,33 @@ static void sigsys_handler( int signal, siginfo_t *siginfo, void *_sigcontext )
         RIP_sig(sigcontext) -= 2;  /* retry the syscall */
         return;
     }
+
+    /* HACK: The EOS version of easy anti cheat executes linux syscalls in a high address
+     * to evade the older seccomp based syscall emulation. It maps a page at
+     * 0x700100000000 and uses it to execute syscalls.
+     * The child process does more of the same but at different address.
+     * Detect this case and execute the linux syscall instead. */
+    if ((long)RIP_sig(ucontext) >= 0x700100000000 && use_eos_syscall_hack)
+    {
+        /* block syscall user dispatch, if it was already blocked we wont be in this handler */
+        __asm__ (
+            "movq %%gs:0x30,%%r13\n\t"
+            "movb $0, 0x340(%%r13)\n\t"
+            ::: "r13"
+        );
+
+        RAX_sig(ucontext) = syscall(RAX_sig(ucontext), RDI_sig(ucontext), RSI_sig(ucontext),
+                                    RDX_sig(ucontext), R10_sig(ucontext), R8_sig(ucontext),
+                                    R9_sig(ucontext));
+
+        /* restore syscall user dispatch state */
+        __asm__ (
+            "movq %%gs:0x30,%%r13\n\t"
+            "movb $1, 0x340(%%r13)\n\t"
+            ::: "r13"
+        );
+        return;
+    }
 #endif
 
     frame->rip = RIP_sig(sigcontext) + 0xb;
@@ -2859,6 +2889,7 @@ void signal_init_process( TEB *teb )
 #ifdef __linux__
     if (syscall_dispatch_enabled)
     {
+        const char *env;
         struct sigaction act;
 
         if (sigaction( SIGSYS, NULL, &act ) == -1)
@@ -2871,6 +2902,12 @@ void signal_init_process( TEB *teb )
             WARN_(seh)( "could not find library containing signal restorer trampoline\n" );
             syscall_dispatch_enabled = FALSE;
         }
+        else
+        {
+            /* We don't unset the env since child processes also need to inherit the same syscall hack */
+            use_eos_syscall_hack = (env = getenv("PROTON_SYSCALL_HACK")) && !strcmp(env, "1");
+            if (use_eos_syscall_hack) ERR_(seh)("Using EAC bootstrapper (EOS) syscall workaround!\n");
+        }
     }
 #endif
 
