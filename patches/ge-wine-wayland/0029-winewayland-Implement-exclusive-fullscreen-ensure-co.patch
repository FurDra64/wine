 };
+
+enum wayland_surface_ensure_type
+{
+    WAYLAND_SURFACE_NOT_ENSURED = 0,
+    WAYLAND_SURFACE_ENSURED_FLUSH,
+    WAYLAND_SURFACE_ENSURED_DUMMY_BUFFER,
+};
 
