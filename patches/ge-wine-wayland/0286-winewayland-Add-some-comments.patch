From 3ed93905ceeeac99610b0d121165e54ff7afbb6e Mon Sep 17 00:00:00 2001
From: Etaash Mathamsetty <45927311+BananaWorks07@users.noreply.github.com>
Date: Wed, 2 Sep 2026 00:22:43 -0500
Subject: [PATCH] winewayland: Add some comments.

we are so back!
---
 dlls/winewayland.drv/waylanddrv.h | 2 ++
 dlls/winewayland.drv/window.c     | 6 +++---
 2 files changed, 5 insertions(+), 3 deletions(-)
diff --git a/dlls/winewayland.drv/waylanddrv.h b/dlls/winewayland.drv/waylanddrv.h
index 1cb525b2..81c81d51 100644
--- a/dlls/winewayland.drv/waylanddrv.h
+++ b/dlls/winewayland.drv/waylanddrv.h
@@ -414,6 +414,8 @@ void WAYLAND_ReleaseKbdTables(const KBDTABLES *);
 void activate_keyboard_hkl(HWND hwnd, BOOL ime);
 
 /**********************************************************************
+    /* TODO: We can remove this once FSHack is implemented in opengl and vulkan upstream for all drivers.
+     * The opengl implementation is already merged. Then we would only need to ensure contents via expose. */
  *          Wayland pointer
  */
 
diff --git a/dlls/winewayland.drv/window.c b/dlls/winewayland.drv/window.c
index 270fdfb4..f80a5ca1 100644
--- a/dlls/winewayland.drv/window.c
+++ b/dlls/winewayland.drv/window.c
@@ -492,9 +492,9 @@ static void wayland_configure_window(HWND hwnd)
         return;
     }
 
-    if (!wayland_surface_is_toplevel(surface))
+    if (!surface->xdg_surface)
     {
-        TRACE("missing xdg_toplevel, returning\n");
+        TRACE("missing xdg_surface, returning\n");
         wayland_win_data_release(data);
         return;
     }
@@ -576,7 +576,7 @@ static void wayland_configure_window(HWND hwnd)
         send_message(hwnd, WM_SYSCOMMAND, SC_RESTORE, 0);
         return;
     }
-
+    /* TODO: Move window based on which outputs it is mapped on */
     SetRect(&rect, 0, 0, width, height);
     rect = map_rect_from_surface(surface, rect);
     OffsetRect(&rect, data->rects.window.left, data->rects.window.top);
