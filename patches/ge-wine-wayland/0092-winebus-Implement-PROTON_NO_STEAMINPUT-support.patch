From 71169c7ed8abec266c9db78c4ca692e2fa3e6300 Mon Sep 17 00:00:00 2001
From: Etaash Mathamsetty
 <45927311+Etaash-mathamsetty@users.noreply.github.com>
Date: Sun, 19 Apr 2026 22:40:38 -0500
Subject: [PATCH 092/285] winebus: Implement PROTON_NO_STEAMINPUT support.

---
 dlls/winebus.sys/bus_udev.c | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/dlls/winebus.sys/bus_udev.c b/dlls/winebus.sys/bus_udev.c
index 21b51276..715f629c 100644
--- a/dlls/winebus.sys/bus_udev.c
+++ b/dlls/winebus.sys/bus_udev.c
@@ -1758,6 +1758,13 @@ static void process_monitor_event(struct udev_monitor *monitor)
         ERR("event for udev device %s does not have any action!\n", syspath);
     else if (!devnode)
     {
+        const char *env = getenv("PROTON_NO_STEAMINPUT");
+        if (env && !strcmp(env, "1"))
+        {
+            TRACE("evdev %s: ignoring steam input virtual controller\n", debugstr_a(devnode));
+            close(fd);
+            return;
+        }
         /* Pretty normal case, not all devices have associated
          * devnodes. For example root input devices do not, but
          * related/child mouse and event devices do.
