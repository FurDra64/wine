From 275a33068adf27f3b706aee1efe7c3a3e24a1cf7 Mon Sep 17 00:00:00 2001
From: Etaash Mathamsetty
 <45927311+Etaash-mathamsetty@users.noreply.github.com>
Date: Sun, 12 Jul 2026 04:11:51 -0400
Subject: [PATCH 180/285] fixup! winewayland: Do not recursively lock with
 NtUserExposeWindowSurface.

---
 dlls/winewayland.drv/wayland_surface.c | 18 ++++++++++--------
 1 file changed, 10 insertions(+), 8 deletions(-)

diff --git a/dlls/winewayland.drv/wayland_surface.c b/dlls/winewayland.drv/wayland_surface.c
index cc0e2162..6e25aaef 100644
--- a/dlls/winewayland.drv/wayland_surface.c
+++ b/dlls/winewayland.drv/wayland_surface.c
@@ -1354,7 +1354,7 @@ static const struct wl_buffer_listener dummy_buffer_listener =
  * Ensure that the wayland surface has up-to-date contents, by committing
  * a dummy buffer if necessary.
  */
-static void wayland_surface_ensure_contents(struct wayland_surface *surface, BOOL fullscreen)
+static BOOL wayland_surface_ensure_contents(struct wayland_surface *surface, BOOL fullscreen)
 {
     enum wl_shm_format format = fullscreen ? WL_SHM_FORMAT_XRGB8888 : WL_SHM_FORMAT_ARGB8888;
     enum wayland_surface_ensure_type needs_contents = WAYLAND_SURFACE_NOT_ENSURED;
@@ -1382,10 +1382,9 @@ static void wayland_surface_ensure_contents(struct wayland_surface *surface, BOO
     switch (needs_contents)
     {
     case WAYLAND_SURFACE_ENSURED_FLUSH:
-    NtUserExposeWindowSurface(hwnd, 0, NULL);
-        /* fallthrough */
+        return TRUE;
     case WAYLAND_SURFACE_NOT_ENSURED:
-        return;
+        return FALSE;
     case WAYLAND_SURFACE_ENSURED_DUMMY_BUFFER:
         break;
     }
@@ -1393,13 +1392,13 @@ static void wayland_surface_ensure_contents(struct wayland_surface *surface, BOO
     if (!wayland_surface_reconfigure(surface))
     {
         WARN("Failed to reconfigure surface %p\n", surface);
-        return;
+        return FALSE;
     }
 
     if (!(dummy_shm_buffer = wayland_shm_buffer_create(width, height, format)))
     {
         ERR("Failed to create dummy buffer\n");
-        return;
+        return FALSE;
     }
 
     wl_buffer_add_listener(dummy_shm_buffer->wl_buffer, &dummy_buffer_listener,
@@ -1407,13 +1406,14 @@ static void wayland_surface_ensure_contents(struct wayland_surface *surface, BOO
     if (!(damage = NtGdiCreateRectRgn(0, 0, width, height)))
     {
         wayland_shm_buffer_unref(dummy_shm_buffer);
-        return;
+        return FALSE;
     }
 
     wayland_surface_attach_shm(surface, dummy_shm_buffer, damage);
     wl_surface_commit(surface->wl_surface);
     surface->ensured_contents = WAYLAND_SURFACE_ENSURED_DUMMY_BUFFER;
     NtGdiDeleteObjectApp(damage);
+    return FALSE;
 }
 
 
@@ -1423,12 +1423,13 @@ static void wayland_client_surface_present(struct client_surface *client, HDC hd
     HWND hwnd = client->hwnd, toplevel = client->toplevel;
     struct wayland_surface *wayland_surface;
     struct wayland_win_data *data;
+    BOOL expose = FALSE;
 
     if (!(data = wayland_win_data_get(toplevel))) return;
 
     if ((wayland_surface = data->wayland_surface))
     {
-        wayland_surface_ensure_contents(wayland_surface, data->is_fullscreen);
+        expose = wayland_surface_ensure_contents(wayland_surface, data->is_fullscreen);
 
         /* Handle any processed configure request, to ensure the related
          * surface state is applied by the compositor. */
@@ -1442,6 +1443,7 @@ static void wayland_client_surface_present(struct client_surface *client, HDC hd
 
     wayland_win_data_release(data);
 
+    if (expose) NtUserExposeWindowSurface(hwnd, 0, NULL);
     set_client_surface(hwnd, surface);
 }
 
