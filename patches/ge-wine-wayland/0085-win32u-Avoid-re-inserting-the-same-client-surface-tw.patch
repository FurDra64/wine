From 5fa616bbf616ddae47dea5223940602fae80736e Mon Sep 17 00:00:00 2001
From: Etaash Mathamsetty
 <45927311+Etaash-mathamsetty@users.noreply.github.com>
Date: Sat, 2 May 2026 17:28:12 -0500
Subject: [PATCH 085/285] win32u: Avoid re-inserting the same client surface
 twice.

---
 dlls/win32u/window.c | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/dlls/win32u/window.c b/dlls/win32u/window.c
index d3edb9e0..582cb6f9 100644
--- a/dlls/win32u/window.c
+++ b/dlls/win32u/window.c
@@ -384,6 +384,9 @@ void update_client_surfaces( HWND hwnd )
     LIST_FOR_EACH_ENTRY_SAFE( surface, next, &client_surfaces, struct client_surface, entry )
     {
         if (NtUserGetAncestor( surface->hwnd, GA_ROOT ) != hwnd) continue;
+    /* due to client surface reuse, this element may already be in the list */
+    if (!list_empty( &surface->entry )) list_remove( &surface->entry );
+
         client_surface_update_locked( surface );
     }
 
