From b73365f9ea84bca90e9ba644045356c7f3a85c2f Mon Sep 17 00:00:00 2001
From: Etaash Mathamsetty
 <45927311+Etaash-mathamsetty@users.noreply.github.com>
Date: Wed, 1 Jul 2026 15:55:30 -0400
Subject: [PATCH 172/285] win32u: Remove FSR3_UPGRADE support.

---
dlls/win32u/d3dkmt.c | 4 ----

diff --git a/dlls/win32u/d3dkmt.c b/dlls/win32u/d3dkmt.c
index 93763ea..d7018c0 100644
--- a/dlls/win32u/d3dkmt.c
+++ b/dlls/win32u/d3dkmt.c
@@ -1007,10 +1007,6 @@ NTSTATUS WINAPI NtGdiDdDDIQueryAdapterInfo( D3DKMT_QUERYADAPTERINFO *desc )
 
         TRACE("size %x\n", desc->PrivateDriverDataSize);
 
-        /* if this function is not implemented amdxcffx64 falls back to FSR3 upgrades */
-        if ((e = getenv("FSR3_UPGRADE")) && *e == '1')
-            return STATUS_NOT_IMPLEMENTED;
-
         if (!(adapter = get_d3dkmt_adapter( desc->hAdapter ))) return STATUS_INVALID_PARAMETER;
         if (!(physical_device = adapter->physical_device)) return STATUS_INVALID_PARAMETER;
         instance = physical_device->instance;
