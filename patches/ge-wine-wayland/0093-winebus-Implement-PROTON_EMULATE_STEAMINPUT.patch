From 8dec47a525843c35b930676729ac6acecfc033f4 Mon Sep 17 00:00:00 2001
From: Etaash Mathamsetty
 <45927311+Etaash-mathamsetty@users.noreply.github.com>
Date: Sun, 19 Apr 2026 22:59:47 -0500
Subject: [PATCH 093/285] winebus: Implement PROTON_EMULATE_STEAMINPUT.

---
 dlls/winebus.sys/bus_sdl.c | 14 ++++++++++++++
 1 file changed, 14 insertions(+)

diff --git a/dlls/winebus.sys/bus_sdl.c b/dlls/winebus.sys/bus_sdl.c
index 9225efbc..7555490f 100644
--- a/dlls/winebus.sys/bus_sdl.c
+++ b/dlls/winebus.sys/bus_sdl.c
@@ -926,6 +926,12 @@ static BOOL set_report_from_controller_event(struct sdl_device *impl, SDL_Event
     return FALSE;
 }
 
+static BOOL is_emulating_steaminput(void)
+{
+    const char *env = getenv("PROTON_EMULATE_STEAMINPUT");
+    return env && atoi(env);
+}
+
 static void sdl_add_device(unsigned int index)
 {
     struct device_desc desc =
@@ -975,6 +981,14 @@ static void sdl_add_device(unsigned int index)
         desc.version = 0;
     }
 
+    if (is_emulating_steaminput())
+    {
+        TRACE("emulating steam input with %s\n", debugstr_device_desc(&desc));
+        desc.vid = 0x28de;
+        desc.pid = 0x11ff;
+        desc.version = 0;
+    }
+
     if (pSDL_JoystickGetSerial && (sdl_serial = pSDL_JoystickGetSerial(joystick)))
         ntdll_umbstowcs(sdl_serial, strlen(sdl_serial) + 1, desc.serialnumber, ARRAY_SIZE(desc.serialnumber));
 
