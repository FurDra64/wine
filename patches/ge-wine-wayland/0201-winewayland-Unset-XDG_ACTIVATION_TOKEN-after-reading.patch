From: Etaash Mathamsetty
 <45927311+Etaash-mathamsetty@users.noreply.github.com>
Date: Sat, 18 Jul 2026 21:29:54 -0400
Subject: [PATCH 201/285] winewayland: Unset XDG_ACTIVATION_TOKEN after reading
 it.

---
 dlls/winewayland.drv/waylanddrv_main.c |    3 +++
 1 file changed, 3 insertions(+)

diff --git a/dlls/winewayland.drv/waylanddrv_main.c b/dlls/winewayland.drv/waylanddrv_main.c
--- a/dlls/winewayland.drv/waylanddrv_main.c
+++ b/dlls/winewayland.drv/waylanddrv_main.c
@@ -125,6 +125,9 @@ err:
 }
 
 static NTSTATUS waylanddrv_unix_read_events(void *arg)
+    unsetenv("DESKTOP_STARTUP_ID");
+    unsetenv("XDG_ACTIVATION_TOKEN");
+
 {
     int error;
     uint32_t id, proto_err;
