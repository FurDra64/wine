From 9c90cd8ccc32d4f7afaa497f6aa00cf0fef9aa6b Mon Sep 17 00:00:00 2001
From: Etaash Mathamsetty
 <45927311+Etaash-mathamsetty@users.noreply.github.com>
Date: Wed, 29 Apr 2026 22:12:11 -0500
Subject: [PATCH 126/285] winewayland: Use passthrough for some colorspaces.

Required for HDR to look correct on wayland since Windows works in a different way compared to wayland.
---
dlls/winewayland.drv/vulkan.c          | 29 ++++++++++++++
 dlls/winewayland.drv/wayland.c         |  5 ++-
 dlls/winewayland.drv/wayland_output.c  |  4 ++
 dlls/winewayland.drv/wayland_surface.c | 69 ++++++++++++++++++++++++++++++++++
 dlls/winewayland.drv/waylanddrv.h      |  3 ++

diff --git a/dlls/winewayland.drv/vulkan.c b/dlls/winewayland.drv/vulkan.c
index 404c6ff..0d1a73e 100644
--- a/dlls/winewayland.drv/vulkan.c
+++ b/dlls/winewayland.drv/vulkan.c
@@ -92,7 +92,36 @@ static void wayland_map_device_extensions(struct vulkan_device_extensions *exten
 
 static VkResult wayland_vulkan_colorspace_configure(VkColorSpaceKHR *colorspace, struct client_surface *client)
 {
+    struct wp_image_description_v1 *wp_image_description_v1 = NULL;
+    VkColorSpaceKHR old = *colorspace;
+
+    if (process_wayland.supports_scrgb &&
+        old == VK_COLOR_SPACE_EXTENDED_SRGB_LINEAR_EXT)
+    {
+        *colorspace = VK_COLOR_SPACE_PASS_THROUGH_EXT;
+        wp_image_description_v1 =
+            wp_color_manager_v1_create_windows_scrgb(process_wayland.wp_color_manager_v1);
+
+        if (!wp_image_description_v1) goto err;
+    }
+    else if (process_wayland.supports_win_pq &&
+             old == VK_COLOR_SPACE_HDR10_ST2084_EXT)
+    {
+        *colorspace = VK_COLOR_SPACE_PASS_THROUGH_EXT;
+        wp_image_description_v1 =
+            wp_color_manager_v1_create_windows_bt2100(process_wayland.wp_color_manager_v1);
+
+        if (!wp_image_description_v1) goto err;
+    }
+
+    TRACE("mapping colorspace %u => %u\n", old, *colorspace);
+
+    wayland_client_surface_attach_image_description(client, wp_image_description_v1);
+
     return VK_SUCCESS;
+err:
+    ERR("Failed to configure image description for client surface!\n");
+    return VK_ERROR_OUT_OF_HOST_MEMORY;
 }
 
 static const struct vulkan_driver_funcs wayland_vulkan_driver_funcs =
diff --git a/dlls/winewayland.drv/wayland.c b/dlls/winewayland.drv/wayland.c
index 1ed9ef3..e1ad185 100644
--- a/dlls/winewayland.drv/wayland.c
+++ b/dlls/winewayland.drv/wayland.c
@@ -43,7 +43,8 @@ struct wayland process_wayland =
     .output_mutex = PTHREAD_MUTEX_INITIALIZER,
     .supports_extended_volume = FALSE,
     .supports_pq = FALSE,
-    .supports_scrgb = FALSE
+    .supports_scrgb = FALSE,
+    .supports_win_pq = FALSE
 };
 
 /**********************************************************************
@@ -257,7 +258,7 @@ static void registry_handle_global(void *data, struct wl_registry *registry,
 
         process_wayland.wp_color_manager_v1 =
             wl_registry_bind(registry, id, &wp_color_manager_v1_interface,
-                             version < 2 ? version : 2);
+                             version < 3 ? version : 3);
 
         wayland_color_manager_init();
         /* Add image descriptions to existing outputs. */
diff --git a/dlls/winewayland.drv/wayland_output.c b/dlls/winewayland.drv/wayland_output.c
index 9cbb49e..dd783f9 100644
--- a/dlls/winewayland.drv/wayland_output.c
+++ b/dlls/winewayland.drv/wayland_output.c
@@ -222,6 +222,8 @@ static void wayland_output_done(struct wayland_output *output)
         process_wayland.supports_pq &&
         process_wayland.supports_scrgb)
     {
+        if (!process_wayland.supports_win_pq)
+            ERR("Compositor doesn't supports windows_bt2100, HDR10 ST2084 may look broken\n");
         output->current.supports_hdr = (output->current.max_target_lum > output->current.ref_lum);
     }
 
@@ -747,6 +749,8 @@ static void wayland_color_manager_handle_supported_feature(void *data,
 
     if (feature == WP_COLOR_MANAGER_V1_FEATURE_WINDOWS_SCRGB)
         process_wayland.supports_scrgb = TRUE;
+    else if (feature == WP_COLOR_MANAGER_V1_FEATURE_WINDOWS_BT2100)
+        process_wayland.supports_win_pq = TRUE;
     else if (feature == WP_COLOR_MANAGER_V1_FEATURE_EXTENDED_TARGET_VOLUME)
         process_wayland.supports_extended_volume = TRUE;
 
diff --git a/dlls/winewayland.drv/wayland_surface.c b/dlls/winewayland.drv/wayland_surface.c
index 38f20b5..1831748 100644
--- a/dlls/winewayland.drv/wayland_surface.c
+++ b/dlls/winewayland.drv/wayland_surface.c
@@ -1948,6 +1948,75 @@ void wayland_client_surface_attach(struct wayland_client_surface *client, HWND t
 done:
     wayland_win_data_release(toplevel_data);
 }
+static void wayland_image_description_v1_failed(void *user_data,
+                    struct wp_image_description_v1 *wp_image_description_v1,
+                    uint32_t cause, const char *msg)
+{
+    struct wayland_client_surface *surface = user_data;
+    ERR("cause=%u msg=%s\n", cause, debugstr_a(msg));
+
+    wp_image_description_v1_destroy(wp_image_description_v1);
+    client_surface_release(&surface->client);
+}
+
+static void wayland_image_description_v1_ready2(void *user_data,
+                    struct wp_image_description_v1 *wp_image_description_v1,
+                    uint32_t identity_hi, uint32_t identity_lo)
+{
+    struct wayland_client_surface *surface = user_data;
+    TRACE("id=%#x%x\n", identity_hi, identity_lo);
+
+    if (!surface->color_management)
+    {
+        surface->color_management =
+            wp_color_manager_v1_get_surface(process_wayland.wp_color_manager_v1,
+                                            surface->wl_surface);
+        if (!surface->color_management)
+        {
+            ERR("Failed to create color management surface for client surface!\n");
+            return;
+        }
+    }
+    wp_color_management_surface_v1_set_image_description(
+        surface->color_management,
+        wp_image_description_v1,
+        WP_COLOR_MANAGER_V1_RENDER_INTENT_PERCEPTUAL);
+    wp_image_description_v1_destroy(wp_image_description_v1);
+    client_surface_release(&surface->client);
+}
+
+static void wayland_image_description_v1_ready(void *user_data,
+                    struct wp_image_description_v1 *wp_image_description_v1,
+                    uint32_t identity)
+{
+    wayland_image_description_v1_ready2(user_data, wp_image_description_v1, 0, identity);
+}
+
+static const struct wp_image_description_v1_listener client_image_description_listener = {
+    wayland_image_description_v1_failed,
+    wayland_image_description_v1_ready,
+    wayland_image_description_v1_ready2
+};
+
+void wayland_client_surface_attach_image_description(struct client_surface *client,
+                                                     struct wp_image_description_v1 *image_desc)
+{
+    struct wayland_client_surface *surface = impl_from_client_surface(client);
+    if (!image_desc)
+    {
+        if (surface->color_management)
+        {
+            wp_color_management_surface_v1_destroy(surface->color_management);
+            surface->color_management = NULL;
+        }
+        return;
+    }
+
+    client_surface_add_ref(&surface->client);
+    wp_image_description_v1_add_listener(image_desc, &client_image_description_listener, surface);
+    wl_display_flush(process_wayland.wl_display);
+}
+
 
 
 /**********************************************************************
diff --git a/dlls/winewayland.drv/waylanddrv.h b/dlls/winewayland.drv/waylanddrv.h
index a5a568e..c7e02bd 100644
--- a/dlls/winewayland.drv/waylanddrv.h
+++ b/dlls/winewayland.drv/waylanddrv.h
@@ -256,6 +256,7 @@ struct wayland
     LONG input_serial;
     BOOL supports_pq;
     BOOL supports_scrgb;
+    BOOL supports_win_pq;
     BOOL supports_extended_volume;
 };
 
@@ -456,6 +457,8 @@ POINT map_point_to_surface(struct wayland_surface *surface, POINT point);
 RECT map_rect_from_surface(struct wayland_surface *surface, RECT rect);
 POINT map_point_from_surface(struct wayland_surface *surface, POINT point);
 void wayland_client_surface_attach(struct wayland_client_surface *client, HWND toplevel, const RECT *rect);
+void wayland_client_surface_attach_image_description(struct client_surface *client,
+                                                     struct wp_image_description_v1 *image_desc);
 void wayland_surface_set_title(struct wayland_surface *surface, LPCWSTR title);
 void wayland_surface_assign_icon(struct wayland_surface *surface);
 void wayland_surface_set_icon_buffer(struct wayland_surface *surface, UINT type, const ICONINFO *ii);
