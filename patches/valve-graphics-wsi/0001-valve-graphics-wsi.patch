+    attrs.format = format;
+    if (!(context = driver_funcs->p_context_create( &attrs, root ))) return NULL;
+    context->root_context = root ? root : context;
+    context->attrs = attrs;
+
+    TRACE( "Created internal thread context %p with attrs %s (share root %p)\n",
+           context, debugstr_opengl_context_attrs( &attrs ), root );
+    return context;
+}
