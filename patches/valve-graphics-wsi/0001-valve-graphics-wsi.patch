+/* Valve downstream AMD quirk (fda79a override_vendor), ported to the upstream
+ * 11.21 client-context architecture: instead of wrapping glGetString per call
+ * (old-arch wrap_glGetString, absent upstream), the override is applied once to
+ * the vendor/device strings cached in init_client_context, which is exactly
+ * what wgl.c serves for GL_VENDOR / GL_RENDERER. Trigger and mapping logic is
+ * unchanged from Valve. */
+static const char *override_vendor( GLenum name, const char *orig )
+{
+    static int override_vendor = -1;
+
+    if (override_vendor == -1)
+    {
+        int fd;
+        char buffer[4096], *env;
+        int sz;
+
+        override_vendor = 0;
+        if ((env = getenv("WINE_GL_VENDOR_REPORT_AMD")))
+        {
+            override_vendor = env[0] != '0';
+        }
+        else
+        {
+            fd = open("/proc/self/cmdline", O_RDONLY);
+            if (fd != -1)
+            {
+                if ((sz = read(fd, buffer, sizeof(buffer) - 1)) > 0)
+                {
+                    buffer[sz] = 0;
+                    if (strstr(buffer, "\\Paradox Launcher.exe") || strstr(buffer, "Red Tie Runner.exe"))
+                    {
+                        FIXME("HACK: overriding GL vendor and renderer.\n");
+                        override_vendor = 1;
+                    }
+                }
+                close(fd);
+            }
+        }
+    }
+
+    if (!override_vendor) return orig;
+
+    if (name == GL_RENDERER)
+    {
+        if (orig && (strstr(orig, "NVIDIA") || strstr(orig, "Intel"))) return "AMD Radeon Graphics";
+        return orig;
+    }
+    if (name == GL_VENDOR)
+    {
+        if (orig && (strstr(orig, "NVIDIA") || strstr(orig, "Intel"))) return "AMD";
+        return orig;
+    }
+    return orig;
+}
