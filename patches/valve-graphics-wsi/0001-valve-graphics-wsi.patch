+/* PRIVATE GLX cross-fbconfig helper (no public ABI change).
+ * Creates an internal thread context with the EXACT requested pixel format
+ * while preserving the caller's share group (root), profile, no_error,
+ * flags and version. Tries the requested format exactly once via the driver
+ * and returns NULL on failure so the caller keeps the old working context
+ * (allocation-failure-old-safe). It deliberately does NOT scan other formats:
+ * any other format would reproduce the same incompatible pair. */
+static struct opengl_context *internal_context_create_for_format( struct opengl_context_attrs attrs,
+                                                                  struct opengl_context *root, int format )
+{
+    struct opengl_context *context;
