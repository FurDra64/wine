+            elif pointer_array:
+                if self.direction == Direction.INPUT:
+                    body += "        out[i] = UlongToPtr(in[i]);\n"
+                else:
+                    body += "        out[i] = PtrToUlong(in[i]);\n"
+            else:
+                body += "        out[i] = in[i];\n"
+
+            body += "    }\n"
+
+        if return_type:
+            body += "\n    return {0}out;\n".format("(void *)" if pointer_array else "")
+        body += "}\n"
+
+        if not self.conv:
+            body += "#endif /* _WIN64 */\n"
+
+        body += "\n"
+
+        return body
