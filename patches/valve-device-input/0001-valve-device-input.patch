+        cached = s && *s != '0';
+        if (cached) ERR( "HACK: spoofing Steam Input controller vid / pid.\n" );
+    }
+    if (!cached) return;
+
+    desc->vid = 0x045e;
+    desc->pid = 0x028e;
+}
