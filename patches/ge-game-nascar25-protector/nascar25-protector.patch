--- a/dlls/ntdll/unix/signal_x86_64.c
+++ b/dlls/ntdll/unix/signal_x86_64.c
@@ -33,5 +33,6 @@
 #include <stdarg.h>
 #include <stdio.h>
+#include <string.h>
 #include <sys/types.h>
 #include <sys/mman.h>
 #include <unistd.h>
@@ -2613,2 +2613,6 @@
 #if defined(__APPLE__) || defined(__linux__)
+
+static BOOL use_nascar25_hack;
+static int nascar25_hack_checked;
+
 /**********************************************************************
@@ -2620,9 +2624,18 @@
 {
     extern const void *__wine_syscall_dispatcher_prolog_end_ptr;
+    static int n25_repaired;
     ucontext_t *sigcontext = _sigcontext;
     struct thread_data *data = init_handler( sigcontext );
     struct syscall_frame *frame = get_syscall_frame( data );

     TRACE_(seh)("SIGSYS, rax %#lx, rip %#lx.\n", (long)RAX_sig(sigcontext), (long)RIP_sig(sigcontext));
+
+    if (!nascar25_hack_checked)
+    {
+        const char *env = getenv( "SteamGameId" );
+        use_nascar25_hack = env && !strcmp( env, "3873970" );
+        nascar25_hack_checked = 1;
+    }
+
 
 #ifdef __linux__
@@ -2636,6 +2649,41 @@
     }
 #endif

+    /* NASCAR 25's protected loader corrupts its VM state before its first direct
+     * NtProtectVirtualMemory syscall under Wine. Restore the known-good state once. */
+    if (use_nascar25_hack && !n25_repaired && RAX_sig(sigcontext) == 0x50 &&
+        (*(ULONG64 *)R8_sig(sigcontext) >> 48) == 0xf63c &&
+        RIP_sig(sigcontext) - *(ULONG64 *)(RSP_sig(sigcontext) + 0x60) == 0x66ddf28)
+    {
+        const ULONG64 key0 = 0xf63c941b3c2d1603ULL;
+        const ULONG64 key1 = 0xd400941204241403ULL;
+        const ULONG64 key2 = 0x4400141204000401ULL;
+        const ULONG64 key3 = 0x223c000938090200ULL;
+        ULONG64 image_base = RIP_sig(sigcontext) - 0x7373b87;
+
+        *(ULONG64 *)RDX_sig(sigcontext) = image_base + 0x1000;
+        *(ULONG64 *)R8_sig(sigcontext) ^= key0;
+        *(ULONG64 *)(RBP_sig(sigcontext) - 0x11c0) = image_base + 0x1000;
+        *(ULONG64 *)(RBP_sig(sigcontext) - 0x1120) ^= key0;
+        *(ULONG64 *)(RBP_sig(sigcontext) - 0x1100) ^= key0;
+        *(ULONG64 *)(RBP_sig(sigcontext) - 0x08) ^= key3;
+        *(ULONG64 *)(RBP_sig(sigcontext) + 0x48) ^= key1;
+        *(ULONG64 *)(RBP_sig(sigcontext) + 0x70) ^= key2;
+        *(ULONG64 *)(RBP_sig(sigcontext) + 0x78) ^= key2;
+        *(ULONG64 *)(RBP_sig(sigcontext) + 0x98) ^= key3;
+        *(ULONG64 *)(RBP_sig(sigcontext) + 0xa8) ^= key1;
+        *(ULONG64 *)(RBP_sig(sigcontext) + 0xb0) ^= key3;
+        *(ULONG64 *)(RBP_sig(sigcontext) + 0xc0) ^= key1;
+        *(ULONG64 *)(RBP_sig(sigcontext) + 0xc8) ^= key3;
+        RBX_sig(sigcontext) ^= key1;
+        RSI_sig(sigcontext) ^= key0;
+        RDI_sig(sigcontext) ^= 0x1400100000240001ULL;
+        R13_sig(sigcontext) ^= key2;
+        R14_sig(sigcontext) ^= key2;
+        R15_sig(sigcontext) ^= 0x101000000001ULL;
+        n25_repaired = 1;
+    }
+
     frame->rip = RIP_sig(sigcontext) + 0xb;
     frame->rcx = RIP_sig(sigcontext);
     frame->eflags = EFL_sig(sigcontext);
