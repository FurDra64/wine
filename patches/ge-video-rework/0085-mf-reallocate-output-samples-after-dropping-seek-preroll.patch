From: GloriousEggroll <gloriouseggroll@gmail.com>
Subject: [PATCH] mf: Reallocate transform output samples after dropping seek preroll.

When mark-in discards a sample preceding a seek target, it releases the
sample and clears pSample. Retrying ProcessOutput with the same descriptors
violates the contract of transforms requiring caller-allocated output.

In the VRChat HLS reproduction, resuming seeks to 209.8437652 seconds. The
AAC decoder produces earlier preroll, which mark-in drops. The following
call has no output buffer, returns E_FAIL, and stops audio sample requests;
the audio-driven presentation clock then stops as well.

Release and reset all output descriptors, allocate replacement samples,
and reset the status before retrying. Keep stream-change handling and
transform-provided sample allocation unchanged. Extend the session seek
test to require fresh samples while discarding two preroll outputs.

diff --git a/dlls/mf/session.c b/dlls/mf/session.c
--- a/dlls/mf/session.c
+++ b/dlls/mf/session.c
@@ -3878,10 +3878,9 @@ static HRESULT transform_node_pull_samples(const struct media_session *session,
     if (FAILED(hr = allocate_output_samples(session, node, buffers)))
         goto done;
 
-    status = 0;
-
-    do
+    for (;;)
     {
+        status = 0;
         hr = IMFTransform_ProcessOutput(node->object.transform, 0, node->u.transform.output_count, buffers, &status);
         if (hr == MF_E_TRANSFORM_STREAM_CHANGE && SUCCEEDED(hr = transform_node_format_changed(node, buffers)))
         {
@@ -3893,8 +3892,17 @@ static HRESULT transform_node_pull_samples(const struct media_session *session,
 
             hr = IMFTransform_ProcessOutput(node->object.transform, 0, node->u.transform.output_count, buffers, &status);
         }
+
+        if (hr != S_OK || !transform_node_markin_need_more_input(session, node, buffers))
+            break;
+
+        /* Mark-in releases preroll samples. Caller-allocated transforms still
+         * need an output sample on the next attempt to drain the decoder. */
+        release_output_samples(node, buffers);
+        memset(buffers, 0, node->u.transform.output_count * sizeof(*buffers));
+        if (FAILED(hr = allocate_output_samples(session, node, buffers)))
+            goto done;
     }
-    while (hr == S_OK && transform_node_markin_need_more_input(session, node, buffers));
 
     if (hr == MF_E_TRANSFORM_NEED_MORE_INPUT)
         node->flags |= TOPO_NODE_TRANSFORM_NEEDS_INPUT;
diff --git a/dlls/mf/tests/mf.c b/dlls/mf/tests/mf.c
--- a/dlls/mf/tests/mf.c
+++ b/dlls/mf/tests/mf.c
@@ -10470,6 +10470,8 @@ struct test_transform
 
     IMFSample *output;
 
+    unsigned int preroll_samples;
+
     HANDLE flush_event;
 
     IMFAttributes *attributes;
@@ -10875,7 +10877,21 @@ static HRESULT WINAPI test_transform_ProcessOutput(IMFTransform *iface, DWORD fl
 
     if (expect_test_transform_ProcessOutput)
     {
-        if (transform->output)
+        if (transform->preroll_samples)
+        {
+            ok(count == 1, "Unexpected output count %lu.\n", count);
+            ok(!!data->pSample, "Missing caller-allocated sample while draining preroll.\n");
+            if (!data->pSample)
+                return E_INVALIDARG;
+            ok(!data->dwStatus, "Unexpected output status %#lx.\n", data->dwStatus);
+            *status = 0;
+            hr = IMFSample_SetSampleTime(data->pSample, 15000000 - transform->preroll_samples * 5000000);
+            ok(hr == S_OK, "SetSampleTime returned %#lx.\n", hr);
+            hr = IMFSample_SetSampleDuration(data->pSample, 5000000);
+            ok(hr == S_OK, "SetSampleDuration returned %#lx.\n", hr);
+            --transform->preroll_samples;
+        }
+        else if (transform->output)
         {
             *status = 0;
             data->pSample = transform->output;
@@ -11106,6 +11122,7 @@ static void test_media_session_seek(void)
     MFT_OUTPUT_STREAM_INFO output_stream_info = {0};
     struct test_callback *test_callback;
     struct test_media_sink *media_sink;
+    struct test_stream_sink *stream_sink;
     struct test_source *media_source;
     struct test_handler *handler;
     IMFAsyncCallback *callback;
@@ -11120,6 +11137,7 @@ static void test_media_session_seek(void)
     IMFSample *sample;
     DWORD input_idx;
     UINT32 status;
+    DWORD wait_result;
     DWORD count;
     HRESULT hr;
     INT i;
@@ -11291,6 +11309,25 @@ static void test_media_session_seek(void)
     flaky
     compare_object_states(&actual_object_state_record, &expected_seek_start_no_pending_request_records);
 
+    /* Drop two preroll frames before the seek target. Each retry must receive
+     * a fresh caller-allocated output sample, even without another input. */
+    stream_sink = media_sink->stream;
+    stream_sink->sample_event = CreateEventW(NULL, FALSE, FALSE, NULL);
+    ok(!!stream_sink->sample_event, "CreateEventW failed, error %lu.\n", GetLastError());
+    test_transform_from_IMFTransform(mft)->preroll_samples = 3;
+    SET_EXPECT(test_transform_ProcessOutput);
+    SET_EXPECT(test_stream_sink_ProcessSample);
+    hr = IMFStreamSink_QueueEvent(&media_sink->stream->IMFStreamSink_iface, MEStreamSinkRequestSample, &GUID_NULL, S_OK, &propvar);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    wait_result = WaitForSingleObject(stream_sink->sample_event, 1000);
+    ok(wait_result == WAIT_OBJECT_0, "Preroll delivery timed out, result %lu.\n", wait_result);
+    CloseHandle(stream_sink->sample_event);
+    stream_sink->sample_event = NULL;
+    CHECK_CALLED(test_transform_ProcessOutput);
+    CHECK_CALLED(test_stream_sink_ProcessSample);
+    ok(!test_transform_from_IMFTransform(mft)->preroll_samples, "Preroll output stalled.\n");
+    test_transform_from_IMFTransform(mft)->preroll_samples = 0;
+
     /* Test a sample request only (i.e. with no sample delivery), then pause and then start with a seek */
     for (i = 0; i < media_source->stream_count; i++)
         media_source->streams[i]->delay_sample = TRUE;
