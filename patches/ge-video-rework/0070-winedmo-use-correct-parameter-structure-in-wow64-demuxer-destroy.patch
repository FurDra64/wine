From 2110c64d89ccf90e7865031238456b5f20ed1066 Mon Sep 17 00:00:00 2001
From: Nikolay Sivov <nsivov@codeweavers.com>
Date: Fri, 28 Aug 2026 12:37:04 +0200
Subject: [PATCH] winedmo: Use correct parameter structure in
 wow64_demuxer_destroy().

Signed-off-by: Nikolay Sivov <nsivov@codeweavers.com>
diff --git a/dlls/winedmo/unixlib.c b/dlls/winedmo/unixlib.c
index 8ad227dc..39a4ed35 100644
--- a/dlls/winedmo/unixlib.c
+++ b/dlls/winedmo/unixlib.c
@@ -215,7 +215,7 @@ static NTSTATUS wow64_demuxer_destroy( void *arg )
         struct winedmo_demuxer demuxer;
         PTR32 context;
     } *params32 = arg;
-    struct demuxer_destroy_params params;
+    struct demuxer_create_params params;
     NTSTATUS status;
 
     params.demuxer = params32->demuxer;
