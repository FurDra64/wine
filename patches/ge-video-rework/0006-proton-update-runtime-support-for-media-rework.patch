From 6b46c4317f580d6a7a83d9888b39298c722ec37e Mon Sep 17 00:00:00 2001
From: GloriousEggroll <gloriouseggroll@gmail.com>
Date: Tue, 9 Jun 2026 16:00:49 -0600
Subject: [PATCH 6/6] proton: update runtime support for media rework

Carry the remaining runtime and environment support changes needed alongside the winedmo media backend work.

This keeps session helper behavior, loader defaults, prefix registration, and build image assumptions aligned with the Proton media tree after winegstreamer was removed.

No game-specific media workaround is introduced here; the gameplay-visible fixes are documented in the preceding media, SourceReader, Quartz, and audio commits.
Rebased 2026-10-30 onto 75fa5bc0: drop ntdll loader GST_LIVE_LATENCY hunk
(already absent upstream, hacks_init gone); refresh wine.inf.in context
to current dll list.
diff --git a/dlls/wtsapi32/wtsapi32.c b/dlls/wtsapi32/wtsapi32.c
index 5a7e799a..bfb7ddc5 100644
--- a/dlls/wtsapi32/wtsapi32.c
+++ b/dlls/wtsapi32/wtsapi32.c
@@ -795,7 +795,7 @@ BOOL WINAPI WTSUnRegisterSessionNotification(HWND hWnd)
 BOOL WINAPI WTSUnRegisterSessionNotificationEx(HANDLE hServer, HWND hWnd)
 {
     FIXME("Stub %p %p\n", hServer, hWnd);
-    return FALSE;
+    return TRUE;
 }
 
 
diff --git a/loader/preloader_mac.c b/loader/preloader_mac.c
index e4dd6554..de74f29e 100644
--- a/loader/preloader_mac.c
+++ b/loader/preloader_mac.c
@@ -85,8 +85,8 @@ void __stack_chk_fail(void) { return; }
  * dyld4 (starting in Monterey) does not like it to be missing:
  * - running vmmap on a Wine process prints this warning:
  *   "Process exists but has not fully started -- dyld has initialized but libSystem has not"
- * - because libSystem is not initialized, dlerror() always returns NULL (causing GStreamer
- *   to crash on init).
+ * - because libSystem is not initialized, dlerror() always returns NULL (any library
+ *   relying on dlerror() to detect load failures will silently malfunction).
  * - starting with macOS Sonoma, Wine crashes on launch if libSystem is not initialized.
  *
  * Adding __program_vars fixes those issues, and also allows more of the vars to
