From 027ae2bdf81d60934fb832e9f563e70f6caef179 Mon Sep 17 00:00:00 2001
From: GloriousEggroll <gloriouseggroll@gmail.com>
Date: Tue, 9 Jun 2026 16:00:33 -0600
Subject: [PATCH 5/6] audio: smooth decoded media playback
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Update Pulse, MMDevAPI, XAudio2, and Microsoft audio decoder behavior used by the replacement media pipeline.

This covers the audio regressions chased during the session:

- Sky: Children of the Light's in-game theater stream no longer drops into mostly-silent bursts.

- Grandia HD's movie audio can play without the crackling/stutter that was traced to output/logging pressure.

- Underdog Detective [神都不良探] gets decoded video audio without needing stale winetricks overrides.

- The Medium keeps the corrected AAC channel-layout path for C001_51.mp4 without adding a SteamGameId hack.

- Warhammer 40,000: Dakka Squadron keeps audio/video media type negotiation working without the old fake-AAC game branch.

- Kirikiri-engine titles from the removed SteamGameId list use general WMA/AAC decoder behavior instead of forcing the input subtype/tag to PCM.

The Pulse changes keep timer and buffer accounting stable when video playback is producing decoded audio in small bursts.

This version intentionally does not reintroduce DualSense mono/haptic reconnect paths; those endpoints are now treated as removed on unplug and newly created on plug-in.
---
 dlls/msauddecmft/msauddecmft.c |  6 ++-
 dlls/winepulse.drv/pulse.c     | 86 ++++++++++++++++++++++++++++++++++--------
 2 files changed, 74 insertions(+), 18 deletions(-)


diff --git a/dlls/winepulse.drv/pulse.c b/dlls/winepulse.drv/pulse.c
index ef13a1ed..a58e05bd 100644
--- a/dlls/winepulse.drv/pulse.c
+++ b/dlls/winepulse.drv/pulse.c
@@ -24,7 +24,9 @@
 #endif
 
 #include <stdarg.h>
+#include <errno.h>
 #include <pthread.h>
+#include <time.h>
 #include <math.h>
 #include <poll.h>
 
@@ -87,6 +89,8 @@ struct pulse_stream
     struct list packet_filled_head;
 };
 
+static void pulse_write(struct pulse_stream *stream);
+
 typedef struct _ACPacket
 {
     struct list entry;
@@ -139,6 +143,22 @@ static int pulse_cond_wait(void)
     return pthread_cond_wait(&pulse_cond, &pulse_mutex);
 }
 
+static int pulse_cond_timedwait_ms(unsigned int timeout_ms)
+{
+    struct timespec ts;
+
+    clock_gettime(CLOCK_REALTIME, &ts);
+    ts.tv_sec += timeout_ms / 1000;
+    ts.tv_nsec += (timeout_ms % 1000) * 1000000;
+    if (ts.tv_nsec >= 1000000000)
+    {
+        ts.tv_sec++;
+        ts.tv_nsec -= 1000000000;
+    }
+
+    return pthread_cond_timedwait(&pulse_cond, &pulse_mutex, &ts);
+}
+
 static void pulse_broadcast(void)
 {
     pthread_cond_broadcast(&pulse_cond);
@@ -383,14 +403,32 @@ static void pulse_contextcallback(pa_context *c, void *userdata)
 
 static void pulse_stream_state(pa_stream *s, void *user)
 {
+    struct pulse_stream *stream = user;
     pa_stream_state_t state = pa_stream_get_state(s);
-    TRACE("Stream state changed to %i\n", state);
+    TRACE("%p: Stream state changed to %i\n", user, state);
+    if (stream && stream->dataflow == eRender && state == PA_STREAM_READY)
+    {
+        const pa_buffer_attr *attr = pa_stream_get_buffer_attr(s);
+        pa_operation *op;
+
+        if (attr)
+            stream->attr = *attr;
+        if (stream->started)
+        {
+            pulse_write(stream);
+            if (pa_stream_is_corked(s) && (op = pa_stream_cork(s, 0, NULL, NULL)))
+                pa_operation_unref(op);
+        }
+    }
     pulse_broadcast();
 }
 
 static void pulse_attr_update(pa_stream *s, void *user) {
+    struct pulse_stream *stream = user;
     const pa_buffer_attr *attr = pa_stream_get_buffer_attr(s);
-    TRACE("New attributes or device moved:\n");
+    TRACE("%p: New attributes or device moved:\n", user);
+    if (stream && attr)
+        stream->attr = *attr;
     dump_attr(attr);
 }
 
@@ -423,6 +461,11 @@ static BOOL pulse_stream_valid(struct pulse_stream *stream)
     return pa_stream_get_state(stream->stream) == PA_STREAM_READY;
 }
 
+static BOOL pulse_stream_ready(struct pulse_stream *stream)
+{
+    return pulse_stream_valid(stream);
+}
+
 static HRESULT pulse_connect(const char *name)
 {
     pa_context_state_t state;
@@ -1159,6 +1202,7 @@ static NTSTATUS pulse_create_stream(void *args)
         return STATUS_SUCCESS;
     }
 
+    stream->attr = attr;
     if (!(stream = calloc(1, sizeof(*stream))))
     {
         pulse_unlock();
@@ -1198,7 +1242,7 @@ static NTSTATUS pulse_create_stream(void *args)
     hr = pulse_stream_connect(stream, params->device, stream->period_bytes);
     if (SUCCEEDED(hr)) {
         UINT32 unalign;
-        const pa_buffer_attr *attr = pa_stream_get_buffer_attr(stream->stream);
+        const pa_buffer_attr *attr = pulse_stream_ready(stream) ? pa_stream_get_buffer_attr(stream->stream) : &stream->attr;
         SIZE_T size;
 
         stream->attr = *attr;
@@ -2230,7 +2274,7 @@ static NTSTATUS pulse_get_latency(void *args)
         params->result = AUDCLNT_E_DEVICE_INVALIDATED;
         return STATUS_SUCCESS;
     }
-    attr = pa_stream_get_buffer_attr(stream->stream);
+    attr = pulse_stream_ready(stream) ? pa_stream_get_buffer_attr(stream->stream) : &stream->attr;
     if (stream->dataflow == eRender)
         lat = attr->minreq / pa_frame_size(&stream->ss);
     else
@@ -2397,15 +2441,18 @@ static NTSTATUS pulse_set_sample_rate(void *args)
     new_ss = stream->ss;
     new_ss.rate = params->rate;
 
-    if (!wait_pa_operation_complete(pa_stream_update_sample_rate(stream->stream, params->rate, pulse_op_cb, &success)))
-        success = 0;
+    if (pulse_stream_ready(stream))
+    {
+        if (!wait_pa_operation_complete(pa_stream_update_sample_rate(stream->stream, params->rate, pulse_op_cb, &success)))
+            success = 0;
 
-    if (!success) {
-        hr = E_OUTOFMEMORY;
-        goto exit;
+        if (!success) {
+            hr = E_OUTOFMEMORY;
+            goto exit;
+        }
     }
 
-    if (stream->held_bytes)
+    if (stream->held_bytes && pulse_stream_ready(stream))
         wait_pa_operation_complete(pa_stream_flush(stream->stream, pulse_op_cb, &success));
 
     stream->clock_lastpos = stream->clock_written = 0;
