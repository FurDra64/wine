From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: GloriousEggroll <gloriouseggroll@proton.me>
Date: Sun, 23 Aug 2026 00:00:00 -0600
Subject: [PATCH] winedmo: probe codec-aligned H.264 display dimensions

Some MP4 files store the H.264 coded dimensions in their sample and track
headers and rely on SPS cropping for the visible dimensions.  Opening the
container alone therefore reports the coded size.  Grandia's mov01.mp4 is
such a file: it initially reports 1920x1088, while H.264 stream analysis
correctly resolves its visible size to 1920x1080.

The winedmo demuxer normally skips avformat_find_stream_info() when a file
already provides duration and frame-rate metadata.  Probe MP4 H.264 streams
whose dimensions are still codec-block aligned so FFmpeg can apply SPS
cropping before the Media Foundation type is exposed.  Files that already
advertise visible dimensions, including normal 1920x1080 content, retain the
existing fast path.
---
 dlls/winedmo/unix_demuxer.c | 25 ++++++++++++++++++++++++-
 1 file changed, 24 insertions(+), 1 deletion(-)

diff --git a/dlls/winedmo/unix_demuxer.c b/dlls/winedmo/unix_demuxer.c
index d5b60b35..ebe2eb78 100644
--- a/dlls/winedmo/unix_demuxer.c
+++ b/dlls/winedmo/unix_demuxer.c
@@ -327,6 +327,28 @@ static INT64 get_video_frame_duration( const AVFormatContext *ctx, AVStream *avs
     return av_rescale_q( 1, av_inv_q( frame_rate ), (AVRational){1, 10000000} );
 }
 
+static BOOL context_has_h264_codec_aligned_dimensions( const AVFormatContext *ctx )
+{
+    UINT i;
+
+    for (i = 0; i < ctx->nb_streams; ++i)
+    {
+        const AVCodecParameters *par = ctx->streams[i]->codecpar;
+
+        if (par->codec_type != AVMEDIA_TYPE_VIDEO || par->codec_id != AV_CODEC_ID_H264)
+            continue;
+        if (par->width <= 0 || par->height <= 0)
+            continue;
+        if (!(par->width & 15) && !(par->height & 15))
+        {
+            TRACE( "Probing codec-aligned H.264 dimensions %dx%d.\n", par->width, par->height );
+            return TRUE;
+        }
+    }
+
+    return FALSE;
+}
+
 static INT64 get_raw_mpegvideo_duration( const AVFormatContext *ctx )
 {
     struct stream_context *context = ctx->pb ? ctx->pb->opaque : NULL;
@@ -638,6 +660,11 @@ NTSTATUS demuxer_create( void *arg )
         needs_find_stream_info = TRUE;
     }
 
+    /* Codec-aligned H.264 display dimensions in MP4 only resolve after probing. */
+    if (!needs_find_stream_info && strstr( format->name, "mp4" )
+            && context_has_h264_codec_aligned_dimensions( demuxer->ctx ))
+        needs_find_stream_info = TRUE;
+
     if (needs_find_stream_info && (ret = avformat_find_stream_info( demuxer->ctx, NULL )) < 0)
     {
         ERR( "Failed to find stream info, error %s.\n", debugstr_averr( ret ) );
