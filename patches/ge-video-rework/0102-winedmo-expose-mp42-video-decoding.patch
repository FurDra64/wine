+        {.type = MEDIATYPE_Video, .subtype = MFVideoFormat_MP42},
+        {.type = MEDIATYPE_Video, .subtype = MFVideoFormat_mp42},
         {.type = MEDIATYPE_Video, .subtype = MEDIASUBTYPE_WMV1},
         {.type = MEDIATYPE_Video, .subtype = MEDIASUBTYPE_WMV2},
         {.type = MEDIATYPE_Video, .subtype = MEDIASUBTYPE_WMV3},
