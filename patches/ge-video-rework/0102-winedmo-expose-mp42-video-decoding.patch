         {MFMediaType_Video, MFVideoFormat_WMV3},
@@ -104,6 +108,8 @@ HRESULT WINAPI DllRegisterServer(void)
     {
         {.type = MEDIATYPE_Video, .subtype = MFVideoFormat_MP43},
